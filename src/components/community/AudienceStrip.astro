---
const audiences = ["Agency owners", "Marketers", "Developers", "Entrepreneurs"];
// The list runs as a marquee, so it is repeated to loop without a gap.
// Only the first run is read out by screen readers.
const runs = 4;
const items = Array.from({ length: runs }).flatMap((_, run) =>
  audiences.map((audience) => ({ audience, hidden: run > 0 })),
);
---

<div
  class="audience-strip"
  role="region"
  aria-labelledby="audience-strip-label"
>
  <div class="wrap strip-inner">
    <p id="audience-strip-label" class="strip-label">A community for</p>
    <div class="strip-track">
      <ul class="strip-audiences" role="list">
        {
          items.map(({ audience, hidden }) => (
            <li aria-hidden={hidden ? "true" : undefined}>
              <span>{audience}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d="M9 1v16M1 9h16M3.35 3.35l11.3 11.3M3.35 14.65l11.3-11.3" />
              </svg>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
<style>
  .audience-strip {
    background: var(--navy);
    color: var(--on-dark);
    border-top: 1px solid var(--line-dark);
    overflow: hidden;
  }
  .strip-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  .strip-label {
    flex: none;
    margin: 0;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }
  .strip-track {
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }
  .strip-audiences {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 40px;
    width: max-content;
    animation: marquee 34s linear infinite;
  }
  .strip-audiences li {
    display: flex;
    align-items: center;
    gap: 40px;
    font-family: var(--display);
    font-size: clamp(16px, 1.6vw, 21px);
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  /* the stars cycle through the logo colours and the flag red */
  .strip-audiences li svg {
    width: 14px;
    height: 14px;
    color: var(--green);
  }
  .strip-audiences li:nth-child(4n + 2) svg {
    color: var(--blue);
  }
  .strip-audiences li:nth-child(4n + 3) svg {
    color: var(--yellow);
  }
  .strip-audiences li:nth-child(4n + 4) svg {
    color: var(--bd-red);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 640px) {
    .strip-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .strip-track {
      width: 100%;
    }
  }
</style>
