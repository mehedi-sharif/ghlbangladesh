---
const audiences = ["Agency owners", "Marketers", "Developers", "Entrepreneurs"];
---

<div
  class="audience-strip"
  role="region"
  aria-labelledby="audience-strip-label"
>
  <div class="wrap strip-inner">
    <p id="audience-strip-label" class="strip-label">A community for</p>
    <ul class="strip-audiences" role="list">
      {
        audiences.map((audience, index) => (
          <li>
            <span>{audience}</span>
            {index < audiences.length - 1 && (
              <svg
                class="strip-star"
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                aria-hidden="true"
              >
                <path d="M9 1v16M1 9h16M3.35 3.35l11.3 11.3M3.35 14.65l11.3-11.3" />
              </svg>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</div>
<style>
  .audience-strip {
    background: #f6f8f1;
    border-block: 1px solid #dce1d6;
    color: #234b3d;
    font-family: "DM Sans", Arial, sans-serif;
  }
  .strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 45px;
    min-height: 112px;
    padding-block: 26px;
  }
  .strip-label {
    margin: 0;
    color: #7b877d;
    font:
      500 10px/1.5 "DM Sans",
      sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .strip-audiences {
    display: flex;
    align-items: center;
    gap: 29px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .strip-audiences li {
    display: flex;
    align-items: center;
    gap: 29px;
    font-size: clamp(16px, 1.6vw, 23px);
    line-height: 1.4;
    font-weight: 500;
    white-space: nowrap;
    letter-spacing: normal;
  }
  .strip-star {
    flex-shrink: 0;
    color: #a4b28d;
  }
  @media (max-width: 1100px) {
    .strip-inner {
      gap: 30px;
    }
    .strip-audiences,
    .strip-audiences li {
      gap: 20px;
    }
    .strip-star {
      width: 15px;
      height: 15px;
    }
  }
  @media (max-width: 950px) {
    .strip-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }
    .strip-audiences {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (max-width: 760px) {
    .strip-inner {
      padding-block: 25px;
      gap: 20px;
    }
    .strip-audiences {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px 24px;
    }
    .strip-audiences li {
      justify-content: space-between;
      gap: 12px;
      font-size: 17px;
    }
    .strip-audiences li:nth-child(even) .strip-star {
      display: none;
    }
  }
</style>
