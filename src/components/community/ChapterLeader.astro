---
import Button from "./Button.astro";
import Photo from "./Photo.astro";

interface Props {
  headingTag?: "h1" | "h2";
}

const { headingTag = "h2" } = Astro.props;
const Heading = headingTag;
// On its own page (contact) the section leads the page and needs space below the header.
const standalone = headingTag === "h1";
---

<section
  class:list={["chapter-profile", { "chapter-profile-standalone": standalone }]}
  id="chapter-leader"
  aria-labelledby="chapter-profile-name"
>
  <div class="wrap">
    <div class="chapter-profile-inner reveal">
      <div class="chapter-profile-visual">
        <Photo
          name="mehedi-portrait"
          alt="Mehedi Sharif holding a microphone beside the GHL Bangladesh meetup banner"
          sizes="(max-width: 900px) calc(100vw - 32px), 560px"
        />
      </div>
      <div class="chapter-profile-copy">
        <span class="chapter-profile-label"
          ><span class="flag-mark" aria-hidden="true"></span>HighLevel
          Bangladesh chapter leader</span
        >
        <Heading id="chapter-profile-name" class="chapter-profile-name">
          Mehedi Sharif
        </Heading>
        <p class="chapter-profile-intro">
          I’m a HighLevel Certified Admin and the chapter leader for HighLevel
          Bangladesh.
        </p>
        <p class="chapter-profile-description">
          This chapter brings together people in Bangladesh who work with
          HighLevel. I organise our local meetups so we can put faces to names,
          ask questions, and share what we’re learning.
        </p>
        <div class="chapter-profile-actions">
          <Button
            variant="outline"
            label="Facebook"
            href="https://www.facebook.com/mehedi.sharif.titas"
            aria-label="Mehedi Sharif on Facebook (opens in a new tab)"
          />
          <Button
            variant="outline"
            label="Website"
            href="https://mehedisharif.com"
            aria-label="Mehedi Sharif’s website (opens in a new tab)"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chapter-profile {
    padding: 0 0 clamp(80px, 11vw, 150px);
  }
  .chapter-profile-standalone {
    padding-top: clamp(48px, 6vw, 80px);
  }
  .chapter-profile-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
  }
  .chapter-profile-visual {
    position: relative;
    min-height: 520px;
    background: var(--navy);
  }
  .chapter-profile-visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* gradient edge along the bottom of the photo */
  .chapter-profile-visual::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: var(--grad);
  }
  .chapter-profile-copy {
    padding: clamp(32px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .chapter-profile-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    padding: 7px 14px 7px 8px;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .chapter-profile-label .flag-mark {
    width: 20px;
    height: 20px;
    background:
      radial-gradient(
        circle at 46% 50%,
        var(--bd-red) 0 5.4px,
        transparent 6px
      ),
      var(--bd-green);
  }
  .chapter-profile-name {
    font-family: var(--display);
    font-size: clamp(44px, 5.6vw, 80px);
    line-height: 1.02;
    margin: 22px 0 22px;
  }
  .chapter-profile-intro {
    margin: 0 0 16px;
    font-family: var(--display);
    font-size: clamp(20px, 1.9vw, 24px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }
  .chapter-profile-description {
    margin: 0;
    color: var(--ink-2);
  }
  .chapter-profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .chapter-profile-actions :global(.btn) {
    flex: none;
  }
  @media (max-width: 900px) {
    .chapter-profile-inner {
      grid-template-columns: 1fr;
    }
    .chapter-profile-visual {
      min-height: 0;
      aspect-ratio: 4/4.4;
    }
  }
</style>
