---
import Arrow from "./Arrow.astro";
import Photo from "./Photo.astro";

interface Props {
  headingTag?: "h1" | "h2";
}

const { headingTag = "h2" } = Astro.props;
const Heading = headingTag;
---

<section
  class="chapter-profile"
  id="chapter-leader"
  aria-labelledby="chapter-profile-name"
>
  <div class="wrap chapter-profile-inner">
    <div class="chapter-profile-visual">
      <Photo
        name="mehedi-portrait"
        alt="Mehedi Sharif holding a microphone beside the GHL Bangladesh meetup banner"
        sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1362px) 42vw, 525px"
      />
    </div>
    <div class="chapter-profile-copy">
      <span class="chapter-profile-label">Meet your chapter leader</span>
      <Heading id="chapter-profile-name" class="chapter-profile-name">
        Mehedi Sharif
      </Heading>
      <p class="chapter-profile-intro">
        I’m a HighLevel Certified Admin and the chapter leader for HighLevel
        Bangladesh.
      </p>
      <p class="chapter-profile-description">
        This chapter brings together people in Bangladesh who work with
        HighLevel. I organise our local meetups so we can put faces to names,
        ask questions, and share what we’re learning.
      </p>
      <a
        class="chapter-profile-link"
        href="https://mehedisharif.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        Connect with Mehedi <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .chapter-profile {
    background: #f6f8f1;
    color: #193f33;
    font-family: "DM Sans", Arial, sans-serif;
  }
  .chapter-profile-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(36px, 5.5vw, 78px);
    padding-block: 76px;
    border-top: 1px solid #d6ddcf;
  }
  .chapter-profile-visual {
    overflow: hidden;
    border-radius: 4px;
  }
  .chapter-profile-visual :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .chapter-profile-label {
    display: block;
    margin-bottom: 18px;
    color: #64745f;
    font:
      600 10px/1.5 "DM Sans",
      sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .chapter-profile-name {
    margin: 0;
    color: #193f33;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: clamp(34px, 3.5vw, 46px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .chapter-profile-intro,
  .chapter-profile-description {
    max-width: 535px;
    color: #687568;
    font-size: 17px;
    line-height: 1.75;
  }
  .chapter-profile-intro {
    margin-top: 22px;
    color: #315344;
  }
  .chapter-profile-description {
    margin-top: 14px;
  }
  .chapter-profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 44px;
    margin-top: 22px;
    padding-block: 5px 8px;
    border-bottom: 1px solid currentColor;
    color: #193f33;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }
  .chapter-profile-link :global(.arrow-icon) {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    stroke-width: 1.2;
  }
  .chapter-profile-link:hover {
    color: #52714b;
  }
  .chapter-profile-link:focus-visible {
    outline: 2px solid #315344;
    outline-offset: 6px;
  }
  @media (max-width: 760px) {
    .chapter-profile-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
      padding-block: 48px;
    }
    .chapter-profile-label {
      margin-bottom: 14px;
    }
    .chapter-profile-name {
      font-size: clamp(32px, 8vw, 40px);
    }
    .chapter-profile-intro,
    .chapter-profile-description {
      font-size: 16px;
      line-height: 1.75;
    }
    .chapter-profile-intro {
      margin-top: 20px;
    }
    .chapter-profile-link {
      margin-top: 20px;
    }
  }
</style>
