---
import Photo from "./Photo.astro";
---

<section
  class="community-story"
  id="our-story"
  aria-labelledby="community-story-heading"
>
  <div class="wrap story-inner">
    <div class="story-aside">
      <header class="story-heading reveal">
        <span class="kicker">Our story</span>
        <h2 id="community-story-heading">How we started.</h2>
      </header>
      <div class="story-people" role="group" aria-label="Meetup co-organisers">
        <figure class="story-person story-person-mehedi reveal">
          <div class="story-photo">
            <Photo
              name="dsc08548"
              alt="Mehedi Sharif seated with his phone at the GHL Bangladesh meetup"
              sizes="(max-width: 900px) 45vw, 280px"
            />
          </div>
          <figcaption>
            <span class="story-name">Mehedi Sharif</span>
            <span class="story-role">Chapter leader</span>
          </figcaption>
        </figure>
        <figure class="story-person story-person-shariful reveal">
          <div class="story-photo">
            <Photo
              name="dsc08543"
              alt="Shariful Islam speaking into a microphone at the GHL Bangladesh meetup"
              width={1800}
              height={1201}
              sizes="(max-width: 900px) 45vw, 280px"
            />
          </div>
          <figcaption>
            <a
              class="story-name"
              href="https://www.facebook.com/vidmshariful"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Shariful Islam on Facebook (opens in a new tab)"
              >Shariful Islam</a
            >
            <span class="story-role">Co-organiser</span>
          </figcaption>
        </figure>
      </div>
    </div>
    <!-- the story is told by Mehedi; the bar on the left fills as it is read -->
    <div class="story-copy reveal">
      <span class="story-progress" aria-hidden="true"></span>
      <p>
        GHL Bangladesh began with conversations between
        <a
          href="https://www.facebook.com/vidmshariful"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Shariful Islam on Facebook (opens in a new tab)"
          ><strong>Shariful Islam</strong></a
        > and me. We kept talking about how many people in Bangladesh work with GoHighLevel
        every day, yet hardly ever meet in person. We wanted a chance to sit together,
        compare experiences, and get to know the people doing the same work.
      </p>
      <p>
        So we decided to organise an unofficial, community-driven meetup. The
        idea was simple: GHL users in one room, asking questions and sharing
        what was actually working for them.
      </p>
      <p>
        Shariful and I organised that gathering together. For me, starting GHL
        Bangladesh was a way to make those conversations happen: people here
        meeting face to face, sharing practical knowledge, and learning from one
        another.
      </p>
      <div class="story-sign">
        <span class="story-signature"
          >Mehedi Sharif<small>HighLevel Bangladesh chapter leader</small></span
        >
      </div>
    </div>
  </div>
</section>

<script>
  // Reading progress: the bar beside the story fills while the text passes a
  // reading line two thirds down the screen.
  const story = document.querySelector<HTMLElement>(".story-copy");
  if (story) {
    let ticking = false;
    const paint = () => {
      ticking = false;
      const rect = story.getBoundingClientRect();
      const line = window.innerHeight * 0.66;
      const progress = Math.max(
        0,
        Math.min(1, (line - rect.top) / rect.height),
      );
      story.style.setProperty("--rp", progress.toFixed(3));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    paint();
  }
</script>

<style>
  .community-story {
    padding: clamp(80px, 11vw, 150px) 0;
  }
  /* the story panel gets the wider column; the photos grow so the left
     column ends exactly where the panel ends */
  .story-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: stretch;
  }
  .story-aside {
    display: flex;
    flex-direction: column;
  }
  .story-heading h2 {
    font-size: clamp(40px, 6vw, 84px);
    margin-top: 18px;
  }
  .story-people {
    flex: 1;
    min-height: 340px;
    margin-top: clamp(28px, 3vw, 40px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .story-person {
    position: relative;
    display: flex;
    margin: 0;
  }
  /* the second photo starts lower; both end level with the story panel */
  .story-person-shariful {
    margin-top: 56px;
  }
  .story-photo {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    border-radius: calc(var(--radius) + 8px);
    border: 1px solid var(--line);
    background: var(--paper-2);
    box-shadow: 0 40px 80px -50px rgba(6, 29, 48, 0.45);
  }
  .story-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s;
  }
  /* individual crop positions keep each person in frame; the source photos stay intact */
  .story-person-mehedi .story-photo :global(img) {
    object-position: 72% center;
  }
  .story-person-shariful .story-photo :global(img) {
    object-position: 62% center;
  }
  .story-person:hover .story-photo :global(img) {
    transform: scale(1.04);
  }
  /* name label on the photo: frosted navy, like the hero's chapter label */
  .story-person figcaption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: grid;
    gap: 1px;
    justify-items: start;
    padding: 9px 14px 10px 30px;
    border-radius: 16px;
    background: rgba(6, 29, 48, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
  }
  .story-person figcaption::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 17px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }
  .story-person-shariful figcaption::before {
    background: var(--blue);
  }
  .story-name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: #fff;
  }
  a.story-name {
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .story-role {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--on-dark-2);
  }
  /* the story stands out as a panel; the text is always fully readable */
  .story-copy {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 3.5vw, 48px) clamp(28px, 3.5vw, 52px)
      clamp(24px, 3vw, 40px) clamp(32px, 4vw, 56px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -50px rgba(6, 29, 48, 0.45);
  }
  /* large gradient quote mark */
  .story-copy::before {
    content: "\201C";
    position: absolute;
    top: clamp(8px, 1.4vw, 20px);
    left: clamp(26px, 4vw, 56px);
    font-family: var(--display);
    font-size: 120px;
    line-height: 1;
    font-weight: 800;
    opacity: 0.9;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    pointer-events: none;
  }
  /* reading progress along the left edge */
  .story-progress {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .story-progress::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--green),
      var(--blue),
      var(--yellow)
    );
    transform: scaleY(var(--rp, 1));
    transform-origin: top;
  }
  .story-copy p {
    position: relative;
    margin: 0 0 20px;
    color: var(--ink-2);
  }
  .story-copy p:first-of-type {
    font-family: var(--display);
    font-size: clamp(20px, 1.75vw, 24px);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-top: 52px;
  }
  .story-copy p a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .story-copy strong {
    font-weight: inherit;
  }
  .story-sign {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .story-signature {
    display: grid;
    gap: 2px;
    font-family: var(--display);
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
  }
  .story-signature small {
    font-family: var(--body);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
  }
  /* narrower screens: heading, photos, then the story at full width */
  @media (max-width: 1100px) {
    .story-inner {
      grid-template-columns: 1fr;
    }
    .story-people {
      flex: none;
      min-height: 0;
      max-width: 640px;
    }
    .story-photo {
      aspect-ratio: 4/5;
    }
  }
</style>
