---
import Photo from "./Photo.astro";
import Button from "./Button.astro";
import { photos } from "../../data/community";
const featuredPhotoName = "meetup";
const galleryPhotos = [
  ...photos.filter((photo) => photo.name === featuredPhotoName),
  ...photos.filter((photo) => photo.name !== featuredPhotoName),
];
// Bento layout: two large tiles (2 × 2 cells) and six wide tiles (2 cells across).
// Every other photo takes one cell. On phones the grid has two columns.
const tiles: Record<string, "big" | "wide"> = {
  meetup: "big",
  dsc08501: "big",
  dsc08436: "wide",
  dsc08636: "wide",
  dsc08546: "wide",
  dsc08489: "wide",
  dsc08339: "wide",
  dsc08260: "wide",
};
const sizes = {
  big: "(max-width:900px) 100vw, 50vw",
  wide: "(max-width:900px) 50vw, 50vw",
  single: "(max-width:900px) 50vw, 25vw",
};
---

<div
  class="event-gallery"
  id="meetup-gallery"
  role="group"
  aria-label="GHL Meetup Bangladesh 2026 photo gallery"
>
  <div class="event-gallery-grid">
    {
      galleryPhotos.map((photo) => (
        <figure
          class:list={[
            "reveal",
            {
              "event-gallery-big": tiles[photo.name] === "big",
              "event-gallery-wide": tiles[photo.name] === "wide",
            },
          ]}
        >
          <a
            class="event-gallery-photo"
            href={`/images/community/${photo.name}-1800.webp`}
            data-event-photo
            data-caption={photo.caption}
            aria-label={`Enlarge photo: ${photo.alt}`}
            aria-controls="meetup-photo-dialog"
            aria-haspopup="dialog"
          >
            <Photo
              name={photo.name}
              alt={photo.alt}
              sizes={sizes[tiles[photo.name] ?? "single"]}
            />
          </a>
        </figure>
      ))
    }
  </div>
  <dialog
    class="event-photo-dialog"
    id="meetup-photo-dialog"
    aria-labelledby="meetup-photo-dialog-title"
    aria-describedby="meetup-photo-caption"
  >
    <div class="event-photo-dialog-header">
      <h3 id="meetup-photo-dialog-title">
        GHL Meetup Bangladesh 2026<span class="event-photo-counter"></span>
      </h3>
      <Button
        class="event-photo-close"
        variant="ghost"
        size="sm"
        icon="x"
        label="Close"
        aria-label="Close photo viewer"
        autofocus
      />
    </div>
    <!-- the photo is positioned against this frame, so it can never grow over the caption or the buttons -->
    <div class="event-photo-image-frame">
      <img
        class="event-photo-full"
        src="/images/community/meetup-1200.webp"
        alt="GHL Bangladesh meetup photo"
      />
    </div>
    <div class="event-photo-dialog-footer">
      <p id="meetup-photo-caption" aria-live="polite"></p>
      <div class="event-photo-controls">
        <Button
          class="event-photo-previous"
          variant="ghost"
          size="sm"
          icon="left"
          iconFirst
          label="Previous"
          aria-label="Previous photo"
        />
        <Button
          class="event-photo-next"
          variant="ghost"
          size="sm"
          icon="right"
          label="Next"
          aria-label="Next photo"
        />
      </div>
    </div>
  </dialog>
</div>

<!-- green disc that follows the mouse over the gallery -->
<div class="cursor-view" aria-hidden="true">View</div>

<script>
  const root = document.documentElement;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document
    .querySelectorAll<HTMLElement>(".event-gallery")
    .forEach((gallery) => {
      const grid = gallery.querySelector<HTMLElement>(".event-gallery-grid");
      const cursor = document.querySelector<HTMLElement>(".cursor-view");

      // "View" disc: mouse users only
      if (
        grid &&
        cursor &&
        !reduceMotion &&
        matchMedia("(hover:hover) and (pointer:fine)").matches
      ) {
        root.classList.add("has-cursor");
        grid.addEventListener("mousemove", (event) => {
          const overPhoto = (event.target as Element).closest(
            "a[data-event-photo]",
          );
          cursor.style.setProperty("--x", event.clientX + "px");
          cursor.style.setProperty("--y", event.clientY + "px");
          cursor.style.setProperty("--s", overPhoto ? "1" : "0");
        });
        grid.addEventListener("mouseleave", () =>
          cursor.style.setProperty("--s", "0"),
        );
        window.addEventListener(
          "scroll",
          () => cursor.style.setProperty("--s", "0"),
          { passive: true },
        );
      }

      // Photo viewer. Without scripts each photo opens as a normal link.
      const dialog = gallery.querySelector<HTMLDialogElement>(
        "#meetup-photo-dialog",
      );
      const image =
        dialog?.querySelector<HTMLImageElement>(".event-photo-full");
      const caption = dialog?.querySelector<HTMLElement>(
        "#meetup-photo-caption",
      );
      const counter = dialog?.querySelector<HTMLElement>(
        ".event-photo-counter",
      );
      if (
        !dialog ||
        !image ||
        !caption ||
        !counter ||
        typeof dialog.showModal !== "function"
      )
        return;
      const links = Array.from(
        gallery.querySelectorAll<HTMLAnchorElement>("a[data-event-photo]"),
      );
      if (!links.length) return;
      let activeIndex = 0;
      let openingLink: HTMLAnchorElement | null = null;

      const showPhoto = (index: number) => {
        activeIndex = (index + links.length) % links.length;
        const link = links[activeIndex];
        image.src = link.href;
        image.alt =
          link.querySelector<HTMLImageElement>("img")?.alt ||
          "GHL Bangladesh meetup photo";
        caption.textContent =
          link.dataset.caption || "GHL Meetup Bangladesh 2026";
        counter.textContent = `${activeIndex + 1} / ${links.length}`;
      };

      links.forEach((link, index) => {
        link.addEventListener("click", (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          event.preventDefault();
          openingLink = link;
          showPhoto(index);
          if (!dialog.open) dialog.showModal();
        });
      });
      dialog
        .querySelector<HTMLButtonElement>(".event-photo-close")
        ?.addEventListener("click", () => dialog.close());
      dialog
        .querySelector<HTMLButtonElement>(".event-photo-previous")
        ?.addEventListener("click", () => showPhoto(activeIndex - 1));
      dialog
        .querySelector<HTMLButtonElement>(".event-photo-next")
        ?.addEventListener("click", () => showPhoto(activeIndex + 1));
      dialog.addEventListener("keydown", (event) => {
        if (!dialog.open) return;
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          showPhoto(activeIndex + (event.key === "ArrowLeft" ? -1 : 1));
        }
      });
      // a click on the dark area around the photo closes the viewer
      dialog.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (
          target === dialog ||
          target.classList.contains("event-photo-image-frame")
        )
          dialog.close();
      });
      dialog.addEventListener("close", () => {
        if (openingLink?.isConnected)
          openingLink.focus({ preventScroll: true });
      });
    });
</script>

<style>
  .event-gallery-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(150px, 15vw, 220px);
    grid-auto-flow: dense;
    gap: 12px;
  }
  .event-gallery-grid figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--navy-2);
  }
  .event-gallery-wide {
    grid-column: span 2;
  }
  .event-gallery-big {
    grid-column: span 2;
    grid-row: span 2;
  }
  /* tiles rise in one after another */
  :global(.js) .event-gallery-grid figure:global(.reveal) {
    transform: translateY(30px) scale(0.97);
  }
  :global(.js) .event-gallery-grid figure:global(.reveal.in) {
    transform: none;
  }
  .event-gallery-grid figure:nth-child(4n + 2) {
    transition-delay: 0.06s;
  }
  .event-gallery-grid figure:nth-child(4n + 3) {
    transition-delay: 0.12s;
  }
  .event-gallery-grid figure:nth-child(4n + 4) {
    transition-delay: 0.18s;
  }
  .event-gallery-photo {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .event-gallery-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s var(--ease),
      filter 0.4s;
  }
  /* the caption slides up over the photo on hover and keyboard focus */
  .event-gallery-photo::after {
    content: attr(data-caption);
    position: absolute;
    inset: auto 0 0 0;
    padding: 40px 16px 14px;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    background: linear-gradient(transparent, rgba(6, 29, 48, 0.85));
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .event-gallery-photo:hover :global(img),
  .event-gallery-photo:focus-visible :global(img) {
    transform: scale(1.06);
  }
  .event-gallery-photo:hover::after,
  .event-gallery-photo:focus-visible::after {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 900px) {
    .event-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: clamp(110px, 28vw, 220px);
      gap: 8px;
    }
    .event-gallery-wide {
      grid-column: span 1;
    }
  }

  /* with a mouse, the green "View" disc replaces the pointer */
  .cursor-view {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    pointer-events: none;
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--green);
    color: #03210f;
    font: 600 14px var(--body);
    transform: translate3d(var(--x, -200px), var(--y, -200px), 0)
      scale(var(--s, 0));
    transition: transform 0.18s ease-out;
    will-change: transform;
  }
  :global(html:not(.has-cursor)) .cursor-view {
    display: none;
  }
  :global(.has-cursor) .event-gallery-photo {
    cursor: none;
  }

  /* full-screen photo viewer */
  .event-photo-dialog {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(3, 14, 24, 0.94);
    color: #fff;
  }
  .event-photo-dialog::backdrop {
    background: rgba(3, 14, 24, 0.6);
    backdrop-filter: blur(6px);
  }
  .event-photo-dialog[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .event-photo-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px clamp(16px, 3vw, 32px);
  }
  .event-photo-dialog-header h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .event-photo-counter {
    margin-left: 12px;
    font-family: var(--body);
    font-size: 14px;
    font-weight: 500;
    color: var(--on-dark-2);
  }
  .event-photo-image-frame {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 clamp(8px, 6vw, 96px);
  }
  .event-photo-full {
    position: absolute;
    inset: 0 clamp(8px, 6vw, 96px);
    margin: auto;
    max-width: calc(100% - 2 * clamp(8px, 6vw, 96px));
    max-height: 100%;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .event-photo-dialog-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px clamp(16px, 3vw, 32px) 22px;
  }
  .event-photo-dialog-footer p {
    margin: 0;
    font-size: 16px;
    color: var(--on-dark);
  }
  .event-photo-dialog :global(.btn) {
    flex: none;
  }
  .event-photo-controls {
    display: flex;
    gap: 8px;
  }
  @media (max-width: 600px) {
    .event-photo-dialog-footer {
      flex-direction: column;
      align-items: stretch;
    }
    .event-photo-controls {
      justify-content: space-between;
    }
  }
</style>
