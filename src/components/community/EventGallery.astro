---
import Photo from "./Photo.astro";
import { photos } from "../../data/community";
const featuredPhotoName = "meetup";
const galleryPhotos = [
  ...photos.filter((photo) => photo.name === featuredPhotoName),
  ...photos.filter((photo) => photo.name !== featuredPhotoName),
];
const balanceLastRow = (galleryPhotos.length + 3) % 4 === 2;
const isWide = (index: number) =>
  balanceLastRow && index >= galleryPhotos.length - 2;
---

<div
  class="event-gallery"
  id="meetup-gallery"
  role="group"
  aria-label="GHL Meetup Bangladesh 2026 photo gallery"
>
  <div class="event-gallery-grid">
    {
      galleryPhotos.map((photo, index) => (
        <figure
          class:list={{
            "event-gallery-featured": photo.name === featuredPhotoName,
            "event-gallery-wide": isWide(index),
          }}
        >
          <a
            class="event-gallery-photo"
            href={`/images/community/${photo.name}-1800.webp`}
            data-event-photo
            data-caption={photo.caption}
            aria-label={`Enlarge photo: ${photo.alt}`}
            aria-controls="meetup-photo-dialog"
            aria-haspopup="dialog"
          >
            <Photo
              name={photo.name}
              alt={photo.alt}
              sizes={
                photo.name === featuredPhotoName
                  ? "(max-width:760px) 100vw, 50vw"
                  : isWide(index)
                    ? "(max-width:760px) 45vw, 50vw"
                    : "(max-width:760px) 45vw, 23vw"
              }
            />
            {photo.name === featuredPhotoName && (
              <span class="event-gallery-label">From the community</span>
            )}
          </a>
        </figure>
      ))
    }
  </div>
  <dialog
    class="event-photo-dialog"
    id="meetup-photo-dialog"
    aria-labelledby="meetup-photo-dialog-title"
    aria-describedby="meetup-photo-caption"
  >
    <div class="event-photo-dialog-header">
      <h3 id="meetup-photo-dialog-title">GHL Meetup Bangladesh 2026</h3>
      <button
        class="event-photo-close"
        type="button"
        aria-label="Close photo viewer"
        autofocus
        >Close <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          aria-hidden="true"><path d="m3 3 8 8M11 3l-8 8"></path></svg
        ></button
      >
    </div>
    <div class="event-photo-image-frame">
      <img
        class="event-photo-full"
        src="/images/community/meetup-1200.webp"
        alt="GHL Bangladesh meetup photo"
        width="1800"
        height="1201"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="event-photo-dialog-footer">
      <div
        class="event-photo-description"
        aria-live="polite"
        aria-atomic="true"
      >
        <p id="meetup-photo-caption"></p><span class="event-photo-counter"
        ></span>
      </div>
      <div class="event-photo-controls">
        <button
          class="event-photo-previous"
          type="button"
          aria-label="Previous photo"
          ><svg
            width="16"
            height="16"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5"></path></svg
          >Previous</button
        ><button class="event-photo-next" type="button" aria-label="Next photo"
          >Next<svg
            width="16"
            height="16"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"></path></svg
          ></button
        >
      </div>
    </div>
  </dialog>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>(".event-gallery")
    .forEach((gallery) => {
      const recap = gallery.closest<HTMLElement>(".meetup-recap");
      const dialog = gallery.querySelector<HTMLDialogElement>(
        "#meetup-photo-dialog",
      );
      const image =
        dialog?.querySelector<HTMLImageElement>(".event-photo-full");
      const caption = dialog?.querySelector<HTMLElement>(
        "#meetup-photo-caption",
      );
      const counter = dialog?.querySelector<HTMLElement>(
        ".event-photo-counter",
      );
      if (
        !recap ||
        !dialog ||
        !image ||
        !caption ||
        !counter ||
        typeof dialog.showModal !== "function"
      )
        return;
      const links = Array.from(
        recap.querySelectorAll<HTMLAnchorElement>("a[data-event-photo]"),
      );
      if (!links.length) return;
      let activeIndex = 0;
      let openingLink: HTMLAnchorElement | null = null;

      const showPhoto = (index: number) => {
        activeIndex = (index + links.length) % links.length;
        const link = links[activeIndex];
        image.src = link.href;
        image.alt =
          link.querySelector<HTMLImageElement>("img")?.alt ||
          "GHL Bangladesh meetup photo";
        caption.textContent =
          link.dataset.caption || "GHL Meetup Bangladesh 2026";
        counter.textContent = `${activeIndex + 1} / ${links.length}`;
      };

      links.forEach((link, index) => {
        link.addEventListener("click", (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          event.preventDefault();
          openingLink = link;
          showPhoto(index);
          if (!dialog.open) dialog.showModal();
        });
      });
      dialog
        .querySelector<HTMLButtonElement>(".event-photo-close")
        ?.addEventListener("click", () => dialog.close());
      dialog
        .querySelector<HTMLButtonElement>(".event-photo-previous")
        ?.addEventListener("click", () => showPhoto(activeIndex - 1));
      dialog
        .querySelector<HTMLButtonElement>(".event-photo-next")
        ?.addEventListener("click", () => showPhoto(activeIndex + 1));
      dialog.addEventListener("keydown", (event) => {
        if (!dialog.open) return;
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          event.preventDefault();
          showPhoto(activeIndex + (event.key === "ArrowLeft" ? -1 : 1));
        }
      });
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        )
          dialog.close();
      });
      dialog.addEventListener("close", () => {
        if (openingLink?.isConnected)
          openingLink.focus({ preventScroll: true });
      });
    });
</script>

<style>
  .event-gallery {
    min-width: 0;
    align-self: center;
    margin: 0;
    padding: 0;
    border: 0;
    color: #193f33;
    font-family: "Chapter Reference", "DM Sans", sans-serif;
  }
  .event-gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .event-gallery-grid figure {
    margin: 0;
  }
  .event-gallery-featured {
    grid-column: span 2;
    grid-row: span 2;
  }
  .event-gallery-wide {
    grid-column: span 2;
  }
  .event-gallery-photo {
    position: relative;
    display: block;
    border-radius: 4px;
    overflow: hidden;
    background: #dfe5d8;
    cursor: zoom-in;
  }
  .event-gallery-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    transition: filter 0.2s ease;
  }
  .event-gallery-photo:hover :global(img) {
    filter: brightness(0.94);
  }
  .event-gallery-featured .event-gallery-photo,
  .event-gallery-featured :global(img) {
    height: 100%;
  }
  .event-gallery-featured :global(img) {
    object-fit: cover;
  }
  .event-gallery-label {
    position: absolute;
    bottom: 18px;
    left: 18px;
    background: #f9faf3;
    border-radius: 2px;
    padding: 7px 12px;
    color: #254b3c;
    font:
      500 8px/1.6 "DM Sans",
      sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .event-photo-dialog {
    width: min(1100px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100svh - 32px);
    padding: 20px;
    border: 0;
    border-radius: 6px;
    background: #f6f8f1;
    color: #193f33;
    font-family: "Chapter Reference", "DM Sans", sans-serif;
  }
  .event-photo-dialog::backdrop {
    background: #0c241de8;
  }
  .event-photo-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 14px;
  }
  .event-photo-dialog-header h3 {
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    font-weight: 600;
  }
  .event-photo-close,
  .event-photo-controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 44px;
    min-height: 44px;
    padding: 10px 13px;
    border: 1px solid #cbd6c3;
    border-radius: 3px;
    background: transparent;
    color: #234b3d;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .event-photo-close:hover,
  .event-photo-controls button:hover {
    background: #e6eddf;
  }
  .event-photo-image-frame {
    background: #e7ede1;
  }
  .event-photo-full {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100svh - 200px);
    object-fit: contain;
  }
  .event-photo-dialog-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    margin-top: 15px;
  }
  .event-photo-description p {
    margin: 0;
    color: #425f4c;
    font-size: 14px;
    line-height: 1.5;
  }
  .event-photo-counter {
    display: block;
    margin-top: 6px;
    color: #7b887b;
    font-size: 11px;
    line-height: 1.4;
  }
  .event-photo-controls {
    display: flex;
    gap: 9px;
  }
  @media (max-width: 760px) {
    .event-gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .event-gallery-featured {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .event-gallery-wide {
      grid-column: auto;
    }
    .event-gallery-featured :global(img) {
      height: auto;
    }
    .event-gallery-label {
      bottom: 14px;
      left: 14px;
    }
    .event-photo-dialog {
      width: calc(100vw - 20px);
      max-height: calc(100svh - 20px);
      padding: 13px;
    }
    .event-photo-dialog-header {
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 12px;
    }
    .event-photo-dialog-header h3 {
      font-size: 18px;
      padding-top: 9px;
    }
    .event-photo-close {
      font-size: 12px;
      padding-inline: 11px;
    }
    .event-photo-full {
      max-height: max(160px, calc(100svh - 245px));
    }
    .event-photo-dialog-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      margin-top: 13px;
    }
    .event-photo-description p {
      font-size: 13px;
    }
    .event-photo-controls {
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-gallery-photo :global(img),
    .event-photo-close,
    .event-photo-controls button {
      transition: none;
    }
  }
</style>
