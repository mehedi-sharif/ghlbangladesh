---
import Button from "./Button.astro";
import Photo from "./Photo.astro";
import { groupUrl, lastEvent, nextEvent, photos } from "../../data/community";

const cover = photos.find((photo) => photo.name === lastEvent.photo);
const date = new Date(`${lastEvent.date}T00:00:00Z`);
const month = date.toLocaleString("en-GB", { month: "short", timeZone: "UTC" });
const day = date.getUTCDate();
const year = date.getUTCFullYear();
---

<section class="events-overview" id="events" aria-labelledby="events-heading">
  <div class="wrap">
    <div class="events-head reveal">
      <div>
        <span class="kicker">Events</span>
        <h2 id="events-heading">Let’s take the conversation offline.</h2>
      </div>
      <p>
        Come for a new idea. Stay for the connections. Our local meetups bring
        the community together to learn, ask questions, and share.
      </p>
    </div>

    <div class="events-grid">
      <!-- the meetup that happened: a card with its group photo -->
      <article
        class="event-panel event-past reveal"
        aria-labelledby="last-event-name"
      >
        <div class="event-cover">
          {
            cover && (
              <Photo
                name={cover.name}
                alt={cover.alt}
                sizes="(max-width: 900px) calc(100vw - 32px), 680px"
              />
            )
          }
          <span class="event-badge">Last event</span>
          <span class="event-count">{photos.length} photos</span>
        </div>
        <div class="event-body">
          <time class="event-cal" datetime={lastEvent.date}
            ><span class="event-cal-top">{month}</span><strong>{day}</strong
            ><span class="event-cal-bottom">{year}</span></time
          >
          <div class="event-text">
            <h3 id="last-event-name">{lastEvent.name}</h3>
            <p>{lastEvent.summary}</p>
            <p class="event-detail">
              {lastEvent.dateLabel} · {lastEvent.organisers}
            </p>
            <div class="event-actions">
              <Button
                variant="outline"
                size="sm"
                icon="down"
                label="See the photos"
                href="#event-photos"
              />
              <a class="event-link" href={lastEvent.galleryUrl}
                >Photo gallery page</a
              >
            </div>
          </div>
        </div>
      </article>

      <!-- the next one: a "save the date" ticket -->
      <article
        class="event-panel event-next reveal"
        aria-labelledby="next-event-title"
      >
        <div class="ticket-top">
          <span class="event-badge event-badge-live"
            ><span class="event-pulse" aria-hidden="true"></span>Upcoming event</span
          >
          <div class="event-cal event-cal-tba" aria-hidden="true">
            <span class="event-cal-top">Date</span><strong>TBA</strong>
          </div>
          <h3 id="next-event-title">{nextEvent.title}</h3>
          <p>{nextEvent.summary}</p>
          <p class="event-detail">{nextEvent.dateLabel} · {nextEvent.place}</p>
        </div>
        <div class="ticket-tear" aria-hidden="true"></div>
        <div class="ticket-bottom">
          <Button size="sm" label="Get event updates" href={groupUrl} />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .events-overview {
    padding: clamp(64px, 8vw, 110px) 0;
  }
  .events-head {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(24px, 6vw, 96px);
    align-items: end;
  }
  .events-head h2 {
    margin-top: 18px;
    max-width: 16ch;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.04;
  }
  .events-head p {
    margin: 0;
    color: var(--ink-2);
  }
  .events-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(36px, 4.5vw, 56px);
    align-items: stretch;
  }
  .event-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
  }
  .event-panel p {
    margin: 0;
  }
  .event-panel h3 {
    font-size: clamp(20px, 1.8vw, 24px);
    line-height: 1.2;
  }

  /* last event */
  .event-past {
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -50px rgba(6, 29, 48, 0.45);
  }
  .event-cover {
    position: relative;
    height: clamp(190px, 19vw, 270px);
    background: var(--navy-2);
  }
  .event-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: transform 0.7s var(--ease);
  }
  .event-past:hover .event-cover :global(img) {
    transform: scale(1.03);
  }
  .event-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(6, 29, 48, 0.35) 0%,
      transparent 40%,
      rgba(6, 29, 48, 0.45) 100%
    );
    pointer-events: none;
  }
  .event-badge,
  .event-count {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(6, 29, 48, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .event-badge {
    top: 14px;
    left: 14px;
  }
  .event-count {
    right: 14px;
    bottom: 14px;
    letter-spacing: 0;
    text-transform: none;
  }
  .event-body {
    flex: 1;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding: clamp(20px, 2.4vw, 30px);
  }
  .event-text p {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 15.5px;
  }
  .event-panel .event-detail {
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .event-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 18px;
  }
  .event-actions :global(.btn) {
    flex: none;
  }
  .event-link {
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* calendar block */
  .event-cal {
    display: grid;
    grid-template-rows: auto 1fr auto;
    width: 74px;
    height: 84px;
    border-radius: 16px;
    overflow: hidden;
    text-align: center;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .event-cal-top {
    padding: 4px 0;
    background: var(--green);
    color: #04240f;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .event-cal strong {
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .event-cal-bottom {
    padding-bottom: 6px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-3);
  }

  /* upcoming event: navy ticket with a perforated tear line */
  .event-next {
    background:
      radial-gradient(
        120% 70% at 100% 0%,
        rgba(248, 211, 37, 0.14),
        transparent 60%
      ),
      linear-gradient(160deg, #0c2c4a 0%, var(--navy) 70%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .ticket-top {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(22px, 2.6vw, 32px) clamp(22px, 2.6vw, 32px) 24px;
  }
  .event-badge-live {
    position: static;
    background: rgba(248, 211, 37, 0.12);
    border-color: rgba(248, 211, 37, 0.35);
    color: var(--yellow);
  }
  .event-pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .event-pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: event-pulse 2.4s ease-out infinite;
  }
  @keyframes event-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(248, 211, 37, 0.6);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  .event-cal-tba {
    grid-template-rows: auto 1fr;
    margin-top: 22px;
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
  }
  .event-cal-tba .event-cal-top {
    background: var(--yellow);
    color: var(--navy);
  }
  .event-cal-tba strong {
    font-size: 22px;
    color: #fff;
  }
  .event-next h3 {
    margin-top: 20px;
    color: #fff;
  }
  .event-next p {
    margin-top: 8px;
    color: var(--on-dark-2);
    font-size: 15.5px;
  }
  .event-next .event-detail {
    color: var(--on-dark-2);
    opacity: 0.85;
  }
  /* dashed line with a notch cut out on each side, like a ticket stub */
  .ticket-tear {
    position: relative;
    height: 2px;
    margin: 0 18px;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.28) 0 8px,
      transparent 8px 16px
    );
  }
  .ticket-tear::before,
  .ticket-tear::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 28px;
    height: 28px;
    margin-top: -14px;
    border-radius: 50%;
    background: var(--paper);
  }
  .ticket-tear::before {
    left: -32px;
  }
  .ticket-tear::after {
    right: -32px;
  }
  .ticket-bottom {
    padding: 22px clamp(22px, 2.6vw, 32px) clamp(22px, 2.6vw, 28px);
  }

  @media (max-width: 900px) {
    .events-head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .event-body {
      grid-template-columns: 1fr;
    }
  }
</style>
