---
// Events page, upcoming events: the next Bangladesh chapter meetup as a navy
// boarding pass. Its date and venue are not confirmed yet, so the stub shows
// "TBA" on a split-flap board and the button leads to the Facebook group,
// where the announcement will be made. Texts come from `nextEvent`.
import Button from "./Button.astro";
import BangladeshMap from "./BangladeshMap.astro";
import { groupUrl, lastEvent, nextEvent } from "../../data/community";
---

<section class="ep-upcoming" id="upcoming" aria-labelledby="upcoming-title">
  <div class="wrap">
    <div class="ep-upcoming-head reveal">
      <span class="kicker">Upcoming events</span>
      <a class="ep-jump" href="#last-event"
        >Last event · {lastEvent.dateLabel}<svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M8 3.5v9M4 8.5l4 4 4-4"></path></svg
        ></a
      >
    </div>

    <article class="ticket reveal" aria-labelledby="upcoming-title">
      <div class="ticket-main">
        <div class="ticket-top">
          <span class="ticket-badge"
            ><span class="ticket-pulse" aria-hidden="true"></span>Upcoming event</span
          >
          <span class="ticket-status">Announcement coming soon</span>
        </div>
        <h2 id="upcoming-title">
          Your next local<br />
          <span class="grad-text"
            >connection <span class="ticket-nowrap">starts here.</span></span
          >
        </h2>
        <p class="ticket-summary">{nextEvent.summary}</p>
        <div class="ticket-foot">
          <p class="ticket-when">
            <svg
              class="ticket-icon"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="3" y="4.5" width="14" height="12.5" rx="2.5"
              ></rect><path d="M3 8.5h14M7 2.75v3.5M13 2.75v3.5"></path></svg
            ><span>{nextEvent.dateLabel}</span>
            <span class="ticket-place"
              ><span class="ticket-sep">·</span>
              <span class="flag-mark" aria-hidden="true"></span><span
                >{nextEvent.place}</span
              ></span
            >
          </p>
          <Button
            size="lg"
            icon="facebook"
            label="Get Event Updates"
            href={groupUrl}
          />
        </div>
      </div>

      <!-- the stub repeats the date and place for the eye only -->
      <div class="ticket-stub" aria-hidden="true">
        <span class="stub-label stub-label-date">Date</span>
        <strong class="stub-date"
          ><span style="--i: 0">T</span><span style="--i: 1">B</span><span
            style="--i: 2">A</span
          ></strong
        >
        <div class="stub-map">
          <BangladeshMap patternId="ticket-map-dots" />
        </div>
        <span class="stub-label stub-label-place">Place</span>
        <span class="stub-place"
          ><span class="flag-mark"></span>{nextEvent.place}</span
        >
      </div>
    </article>
  </div>
</section>

<style>
  .ep-upcoming {
    padding: clamp(72px, 9vw, 130px) 0 clamp(56px, 7vw, 100px);
  }
  .ep-upcoming-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: clamp(20px, 2.4vw, 30px);
  }
  .ep-jump {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink-2);
    transition: color 0.2s ease;
  }
  .ep-jump svg {
    width: 15px;
    height: 15px;
    transition: transform 0.35s var(--ease);
  }
  .ep-jump:hover {
    color: var(--ink);
  }
  .ep-jump:hover svg {
    transform: translateY(3px);
  }

  /* the pass: main part and stub, joined by a perforated line with a
     half-circle notch at each end (cut out with masks, so any background
     shows through) */
  .ticket {
    --r: 18px;
    --corner: calc(var(--radius) + 8px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(250px, 25vw, 330px);
    filter: drop-shadow(0 36px 36px rgba(6, 29, 48, 0.26));
  }
  .ticket-main,
  .ticket-stub {
    position: relative;
    color: var(--on-dark);
  }
  .ticket-main {
    isolation: isolate;
    overflow: hidden;
    padding: clamp(26px, 4vw, 60px);
    border-radius: var(--corner) 0 0 var(--corner);
    /* fine rings from the corner, like the security print on a ticket */
    background:
      repeating-radial-gradient(
        circle at 100% 0%,
        rgba(255, 255, 255, 0.045) 0 1px,
        transparent 1px 16px
      ),
      linear-gradient(155deg, #0d2f4f 0%, var(--navy) 72%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    -webkit-mask:
      radial-gradient(circle var(--r) at 100% 0, #0000 98%, #000) top / 100% 51%
        no-repeat,
      radial-gradient(circle var(--r) at 100% 100%, #0000 98%, #000) bottom /
        100% 51% no-repeat;
    mask:
      radial-gradient(circle var(--r) at 100% 0, #0000 98%, #000) top / 100% 51%
        no-repeat,
      radial-gradient(circle var(--r) at 100% 100%, #0000 98%, #000) bottom /
        100% 51% no-repeat;
  }
  /* thin band of the three logo colours along the top edge */
  .ticket-main::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--grad);
  }
  .ticket-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }
  .ticket-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 13px;
    border-radius: 999px;
    background: rgba(248, 211, 37, 0.12);
    border: 1px solid rgba(248, 211, 37, 0.35);
    color: var(--yellow);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ticket-pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .ticket-pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: ticket-pulse 2.4s ease-out infinite;
  }
  @keyframes ticket-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(248, 211, 37, 0.6);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  .ticket-status {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }
  .ticket-main h2 {
    margin-top: clamp(28px, 4vw, 56px);
    font-family: var(--display);
    font-size: clamp(34px, 4.8vw, 70px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: #fff;
  }
  .ticket-main h2 .grad-text {
    padding-bottom: 0.06em;
  }
  .ticket-summary {
    margin: 20px 0 0;
    max-width: 470px;
    color: var(--on-dark-2);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.6;
  }
  .ticket-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 28px;
    margin-top: clamp(28px, 3.6vw, 48px);
    padding-top: clamp(20px, 2.4vw, 28px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .ticket-when {
    margin: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
  }
  .ticket-when > * {
    vertical-align: middle;
  }
  .ticket-icon {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin: -2px 10px 0 0;
    color: var(--yellow);
  }
  .ticket-place,
  .ticket-nowrap {
    white-space: nowrap;
  }
  .ticket-place > * {
    vertical-align: middle;
  }
  .ticket-sep {
    margin: 0 6px;
    color: var(--on-dark-2);
  }
  .ticket-when .flag-mark {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin: -2px 9px 0 0;
    background:
      radial-gradient(
        circle at 46% 50%,
        var(--bd-red) 0 5.4px,
        transparent 6px
      ),
      var(--bd-green);
  }

  /* stub: date on a split-flap board, the dotted map of Bangladesh */
  .ticket-stub {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(26px, 3.4vw, 44px) clamp(22px, 2.8vw, 38px);
    border-radius: 0 var(--corner) var(--corner) 0;
    background:
      radial-gradient(
        120% 60% at 50% 0%,
        rgba(248, 211, 37, 0.1),
        transparent 70%
      ),
      linear-gradient(170deg, #103657 0%, #0a2640 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    transform-origin: 0 100%;
    transition: transform 0.7s var(--ease);
    -webkit-mask:
      radial-gradient(circle var(--r) at 0 0, #0000 98%, #000) top / 100% 51%
        no-repeat,
      radial-gradient(circle var(--r) at 0 100%, #0000 98%, #000) bottom / 100%
        51% no-repeat;
    mask:
      radial-gradient(circle var(--r) at 0 0, #0000 98%, #000) top / 100% 51%
        no-repeat,
      radial-gradient(circle var(--r) at 0 100%, #0000 98%, #000) bottom / 100%
        51% no-repeat;
  }
  /* perforation between the two parts */
  .ticket-stub::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(var(--r) + 8px);
    bottom: calc(var(--r) + 8px);
    width: 2px;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.3) 0 7px,
      transparent 7px 14px
    );
  }
  /* pointing at the pass lifts the stub a little, as if about to tear off */
  @media (hover: hover) and (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    .ticket:hover .ticket-stub {
      transform: rotate(1.6deg) translate(5px, -2px);
    }
  }
  .stub-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }
  .stub-date {
    display: flex;
    gap: 6px;
    margin-top: 12px;
    perspective: 400px;
  }
  .stub-date span {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(46px, 4.6vw, 62px);
    height: clamp(58px, 5.8vw, 78px);
    border-radius: 10px;
    background: linear-gradient(180deg, #0b2a46 0 50%, #082239 50% 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.09),
      0 10px 18px -10px rgba(0, 0, 0, 0.6);
    font-family: var(--display);
    font-size: clamp(34px, 3.4vw, 48px);
    font-weight: 800;
    line-height: 1;
    color: var(--yellow);
  }
  /* the hinge across the middle of each flap */
  .stub-date span::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(2, 12, 20, 0.85);
  }
  :global(.js) .ticket:global(.in) .stub-date span {
    animation: ticket-flap 0.9s var(--ease) both;
    animation-delay: calc(0.35s + var(--i) * 0.14s);
  }
  @keyframes ticket-flap {
    from {
      transform: rotateX(-100deg);
      opacity: 0;
    }
  }
  .stub-map {
    flex: 1;
    display: grid;
    place-items: center;
    width: 100%;
    margin: 26px 0 22px;
  }
  .ticket-stub .stub-map :global(.bd-map) {
    width: 100%;
    max-width: 200px;
    height: auto;
  }
  .ticket-stub .stub-map :global(.bd-map pattern circle) {
    fill: rgba(242, 246, 244, 0.42);
  }
  .ticket-stub .stub-map :global(.map-arrow) {
    stroke: #0d2f4d;
  }
  /* no lights on the ticket: the venue isn't known yet */
  .ticket-stub .stub-map :global(.map-light) {
    display: none;
  }
  .stub-place {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    font-family: var(--display);
    font-size: 20px;
    font-weight: 700;
    color: #fff;
  }

  /* dark theme: a lighter navy, so the pass stands off the dark page */
  :global(:root[data-theme="dark"]) .ticket {
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
  }
  :global(:root[data-theme="dark"]) .ticket-main {
    background:
      repeating-radial-gradient(
        circle at 100% 0%,
        rgba(255, 255, 255, 0.05) 0 1px,
        transparent 1px 16px
      ),
      linear-gradient(155deg, #123a5f 0%, #0b2740 72%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  :global(:root[data-theme="dark"]) .ticket-stub {
    background:
      radial-gradient(
        120% 60% at 50% 0%,
        rgba(248, 211, 37, 0.1),
        transparent 70%
      ),
      linear-gradient(170deg, #164672 0%, #0f3150 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  :global(:root[data-theme="dark"]) .ticket-stub .stub-map :global(.map-arrow) {
    stroke: #123c61;
  }

  /* narrower screens: the stub sits under the main part */
  @media (max-width: 860px) {
    .ticket {
      grid-template-columns: 1fr;
    }
    .ticket-main {
      border-radius: var(--corner) var(--corner) 0 0;
      -webkit-mask:
        radial-gradient(circle var(--r) at 0 100%, #0000 98%, #000) left / 51%
          100% no-repeat,
        radial-gradient(circle var(--r) at 100% 100%, #0000 98%, #000) right /
          51% 100% no-repeat;
      mask:
        radial-gradient(circle var(--r) at 0 100%, #0000 98%, #000) left / 51%
          100% no-repeat,
        radial-gradient(circle var(--r) at 100% 100%, #0000 98%, #000) right /
          51% 100% no-repeat;
    }
    .ticket-stub {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "label map"
        "date map"
        "plabel map"
        "place map";
      align-items: start;
      column-gap: 20px;
      border-radius: 0 0 var(--corner) var(--corner);
      -webkit-mask:
        radial-gradient(circle var(--r) at 0 0, #0000 98%, #000) left / 51% 100%
          no-repeat,
        radial-gradient(circle var(--r) at 100% 0, #0000 98%, #000) right / 51%
          100% no-repeat;
      mask:
        radial-gradient(circle var(--r) at 0 0, #0000 98%, #000) left / 51% 100%
          no-repeat,
        radial-gradient(circle var(--r) at 100% 0, #0000 98%, #000) right / 51%
          100% no-repeat;
    }
    .ticket-stub::before {
      top: 0;
      bottom: auto;
      left: calc(var(--r) + 8px);
      right: calc(var(--r) + 8px);
      width: auto;
      height: 2px;
      background: repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.3) 0 7px,
        transparent 7px 14px
      );
    }
    .stub-label-date {
      grid-area: label;
    }
    .stub-date {
      grid-area: date;
    }
    .stub-label-place {
      grid-area: plabel;
      margin-top: 20px;
    }
    .stub-place {
      grid-area: place;
    }
    .stub-map {
      grid-area: map;
      align-self: stretch;
      place-items: center end;
      min-height: 0;
      margin: 0;
    }
    .ticket-stub .stub-map :global(.bd-map) {
      max-width: 150px;
    }
  }
  @media (max-width: 480px) {
    .ticket {
      --r: 14px;
    }
    /* the place goes on its own line under the date */
    .ticket-place {
      display: block;
      margin-top: 6px;
    }
    .ticket-sep {
      display: none;
    }
    .ticket-foot :global(.btn) {
      width: 100%;
    }
    .stub-date span {
      width: 42px;
      height: 54px;
      font-size: 32px;
    }
  }
</style>
