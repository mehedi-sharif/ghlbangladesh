---
import { groupUrl } from "../../data/community";
import Button from "./Button.astro";

// The three rising arrows of the GHL logo (yellow, blue, green). Each is drawn
// twice: a solid arrow and a faint outline above it. Both fade out at the bottom.
const arrows = [
  { color: "#F8D325", top: 330, path: "M95 330L160 394H123V600H67V394H30Z" },
  { color: "#20A9ED", top: 180, path: "M260 180L325 244H288V600H232V244H195Z" },
  { color: "#0BCE55", top: 30, path: "M425 30L490 94H453V600H397V94H360Z" },
];
---

<section class="footer-invite" id="join" aria-labelledby="invite-heading">
  <div class="wrap">
    <div class="invite-card reveal">
      <svg
        class="invite-arrows"
        viewBox="0 0 520 600"
        preserveAspectRatio="xMaxYMax meet"
        aria-hidden="true"
        ><defs
          >{
            arrows.map((arrow, index) => (
              <>
                <linearGradient
                  id={`iaf${index + 1}`}
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1={arrow.top}
                  x2="0"
                  y2="600"
                >
                  <stop offset="0" stop-color="#fff" />
                  <stop offset=".45" stop-color="#fff" stop-opacity=".85" />
                  <stop offset="1" stop-color="#fff" stop-opacity="0" />
                </linearGradient>
                <mask
                  id={`iam${index + 1}`}
                  maskUnits="userSpaceOnUse"
                  x="-20"
                  y="-80"
                  width="560"
                  height="700"
                >
                  <rect
                    x="-20"
                    y="-80"
                    width="560"
                    height="700"
                    fill={`url(#iaf${index + 1})`}
                  />
                </mask>
              </>
            ))
          }</defs
        >{
          arrows.map((arrow, index) => (
            <g class={`ia ia-${index + 1}`}>
              <g mask={`url(#iam${index + 1})`}>
                <path
                  d={arrow.path}
                  transform="translate(0 -44)"
                  fill="none"
                  stroke={arrow.color}
                  stroke-width="2.5"
                  stroke-linejoin="round"
                  opacity=".38"
                />
                <path
                  d={arrow.path}
                  fill={arrow.color}
                  stroke={arrow.color}
                  stroke-width="10"
                  stroke-linejoin="round"
                />
              </g>
            </g>
          ))
        }</svg
      >
      <h2 id="invite-heading">
        Great things start with a <span class="grad-text">connection.</span>
      </h2>
      <Button size="lg" label="Join the community" href={groupUrl} />
    </div>
  </div>
</section>

<style>
  .footer-invite {
    padding: 0 0 clamp(80px, 10vw, 130px);
  }
  .invite-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-radius: calc(var(--radius) + 10px);
    background: linear-gradient(150deg, #0c2c4a 0%, var(--navy) 58%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    color: #fff;
    padding: clamp(40px, 7vw, 96px) clamp(28px, 6vw, 90px);
    min-height: clamp(460px, 44vw, 620px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(28px, 3.4vw, 44px);
  }
  .invite-card h2 {
    font-family: var(--display);
    font-size: clamp(40px, 6.2vw, 94px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 11ch;
  }
  .invite-arrows {
    position: absolute;
    z-index: -1;
    right: clamp(12px, 5vw, 84px);
    bottom: 0;
    width: 46%;
    height: 94%;
    overflow: visible;
  }
  .invite-arrows .ia {
    transition:
      transform 1.3s var(--ease),
      opacity 1s ease;
  }
  .invite-arrows .ia-2 {
    transition-delay: 0.12s;
  }
  .invite-arrows .ia-3 {
    transition-delay: 0.24s;
  }
  :global(.js) .invite-card .ia {
    transform: translateY(140px);
    opacity: 0;
  }
  :global(.js) .invite-card:global(.in) .ia {
    transform: none;
    opacity: 1;
  }
  /* the arrows lift a little while the button is hovered */
  @media (hover: hover) {
    .invite-card:global(.in:has(.btn:hover)) .ia {
      transform: translateY(-16px);
      transition-duration: 0.55s;
    }
    .invite-card:global(.in:has(.btn:hover)) .ia-1 {
      transition-delay: 0s;
    }
    .invite-card:global(.in:has(.btn:hover)) .ia-2 {
      transition-delay: 0.05s;
    }
    .invite-card:global(.in:has(.btn:hover)) .ia-3 {
      transition-delay: 0.1s;
    }
  }
  @media (max-width: 760px) {
    .invite-card {
      justify-content: flex-end;
      min-height: 520px;
    }
    .invite-arrows {
      top: 0;
      bottom: auto;
      right: 8px;
      width: 72%;
      height: 52%;
    }
  }
</style>
