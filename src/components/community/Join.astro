---
import { groupUrl } from "../../data/community";
import Button from "./Button.astro";
---

<section class="footer-invite" id="join" aria-labelledby="invite-heading">
  <div class="wrap">
    <div class="invite-card reveal">
      <div class="invite-copy">
        <h2 id="invite-heading">
          Great things start with a <span class="grad-text">connection.</span>
        </h2>
        <p>
          Join agency owners, marketers, developers, and entrepreneurs in
          Bangladesh who build with HighLevel.
        </p>
      </div>
      <div class="invite-action">
        <Button size="lg" label="Join the community" href={groupUrl} />
        <span class="invite-note">HighLevel Bangladesh group on Facebook</span>
      </div>
    </div>
  </div>
</section>

<style>
  .footer-invite {
    padding: 0 0 clamp(64px, 8vw, 110px);
  }
  .invite-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 28px 48px;
    border-radius: calc(var(--radius) + 8px);
    background: linear-gradient(150deg, #0c2c4a 0%, var(--navy) 62%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    color: #fff;
    padding: clamp(28px, 4vw, 56px) clamp(24px, 5vw, 64px);
  }
  /* thin band of the three logo colours along the top edge */
  .invite-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--grad);
  }
  .invite-copy h2 {
    font-family: var(--display);
    font-size: clamp(32px, 3.8vw, 54px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 15ch;
  }
  .invite-copy p {
    margin: 14px 0 0;
    max-width: 520px;
    color: var(--on-dark-2);
    font-size: 16px;
  }
  .invite-action {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .invite-note {
    font-size: 13px;
    color: var(--on-dark-2);
  }
  @media (max-width: 760px) {
    .invite-card {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .invite-action {
      align-items: flex-start;
    }
  }
</style>
