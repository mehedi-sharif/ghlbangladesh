---
import { groupUrl } from "../../data/community";
import Arrow from "./Arrow.astro";
---

<section class="join-section" id="join">
  <div class="wrap join-inner">
    <div>
      <span class="eyebrow">Your community. Your next step.</span><h2>
        There’s a place{" "}<br />for you here.
      </h2>
    </div><div class="join-copy">
      <p>
        Bring your questions, your experience, and your next big idea.{" "}<br
        />Let’s build something better, together.
      </p><a
        class="button button-green"
        href={groupUrl}
        target="_blank"
        rel="noopener noreferrer">Join HighLevel Bangladesh <Arrow /></a
      >
    </div>
  </div>
</section>
