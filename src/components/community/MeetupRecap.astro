---
import EventGallery from "./EventGallery.astro";
---

<section class="meetup-recap" id="events" aria-labelledby="recap-heading">
  <div class="wrap" id="meetup-recap">
    <div class="recap-heading-row">
      <span class="recap-eyebrow">Offline connections. Lasting impact.</span>
      <h2 id="recap-heading">
        See you at the<br /><em>next conversation.</em>
      </h2>
    </div>
    <EventGallery />
  </div>
</section>

<style>
  .meetup-recap {
    padding-block: 92px;
    background: #edf0e6;
    color: #193f33;
    font-family: "Chapter Reference", "DM Sans", sans-serif;
  }
  .recap-heading-row {
    margin-bottom: 44px;
  }
  .recap-eyebrow {
    display: block;
    font:
      600 10px/1.5 "DM Sans",
      sans-serif;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .recap-heading-row h2 {
    font-size: clamp(42px, 4.6vw, 66px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.07;
    margin-top: 25px;
  }
  .recap-heading-row h2 em {
    font-family: Georgia, serif;
    font-size: 1.04em;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.065em;
  }
  @media (max-width: 760px) {
    .meetup-recap {
      padding-block: 60px;
    }
    .recap-heading-row {
      margin-bottom: 32px;
    }
    .recap-heading-row h2 {
      font-size: clamp(36px, 9.2vw, 48px);
      margin-top: 21px;
    }
    .recap-eyebrow {
      font-size: 9px;
    }
  }
</style>
