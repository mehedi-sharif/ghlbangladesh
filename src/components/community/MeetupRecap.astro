---
import EventGallery from "./EventGallery.astro";
---

<section
  class="meetup-recap on-dark"
  id="events"
  aria-labelledby="recap-heading"
>
  <div class="wrap" id="meetup-recap">
    <div class="recap-heading-row reveal">
      <span class="kicker">Offline connections. Lasting impact.</span>
      <h2 id="recap-heading">
        See you at the<br /><span class="grad-text">next conversation.</span>
      </h2>
    </div>
    <EventGallery />
  </div>
</section>

<style>
  .meetup-recap {
    position: relative;
    overflow: hidden;
    padding: clamp(80px, 11vw, 150px) 0;
    background: var(--navy);
    color: var(--on-dark);
  }
  .meetup-recap::before {
    content: "";
    position: absolute;
    left: -20%;
    top: -30%;
    width: 70%;
    height: 80%;
    background: radial-gradient(
      closest-side,
      rgba(11, 206, 85, 0.16),
      transparent
    );
    pointer-events: none;
  }
  .recap-heading-row {
    position: relative;
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  /* centred title: a second gradient dash after the label */
  .recap-heading-row .kicker::after {
    content: "";
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad);
  }
  .recap-heading-row h2 {
    font-size: clamp(34px, 7.2vw, 84px);
    margin-top: 18px;
  }
</style>
