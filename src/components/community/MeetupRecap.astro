---
import Photo from "./Photo.astro";
import EventGallery from "./EventGallery.astro";
---

<section class="meetup-recap" id="events" aria-labelledby="recap-heading">
  <div class="wrap" id="meetup-recap">
    <div class="recap-heading-row">
      <span class="recap-eyebrow">Offline connections. Lasting impact.</span>
      <h2 id="recap-heading">
        See you at the<br /><em>next conversation.</em>
      </h2>
    </div>
    <div class="recap-feature">
      <a
        class="recap-photo"
        href="/images/community/conversations-1800.webp"
        data-event-photo
        data-caption="Members talking together at the meetup."
        aria-label="Enlarge photo: Members of GHL Bangladesh talking together around a table at the meetup"
        aria-haspopup="dialog"
        aria-controls="meetup-photo-dialog"
        ><Photo
          name="conversations"
          alt="Members of GHL Bangladesh talking together around a table at the meetup"
          sizes="(max-width:760px) 100vw, 50vw"
        /><span class="recap-photo-label">From the community</span></a
      >
      <EventGallery />
    </div>
  </div>
</section>

<style>
  .meetup-recap {
    padding-block: 92px;
    background: #edf0e6;
    color: #193f33;
    font-family: "Chapter Reference", "DM Sans", sans-serif;
  }
  .recap-heading-row {
    margin-bottom: 44px;
  }
  .recap-eyebrow {
    display: block;
    font:
      600 10px/1.5 "DM Sans",
      sans-serif;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .recap-heading-row h2 {
    font-size: clamp(42px, 4.6vw, 66px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.07;
    margin-top: 25px;
  }
  .recap-heading-row h2 em {
    font-family: Georgia, serif;
    font-size: 1.04em;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.065em;
  }
  .recap-feature {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .recap-photo {
    position: relative;
    display: block;
    border-radius: 5px;
    overflow: hidden;
    cursor: zoom-in;
  }
  .recap-photo :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .recap-photo-label {
    position: absolute;
    bottom: 18px;
    left: 18px;
    background: #f9faf3;
    border-radius: 2px;
    padding: 7px 12px;
    color: #254b3c;
    font:
      500 8px/1.6 "DM Sans",
      sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 760px) {
    .meetup-recap {
      padding-block: 60px;
    }
    .recap-heading-row {
      margin-bottom: 32px;
    }
    .recap-heading-row h2 {
      font-size: clamp(36px, 9.2vw, 48px);
      margin-top: 21px;
    }
    .recap-eyebrow {
      font-size: 9px;
    }
    .recap-feature {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .recap-photo :global(img) {
      height: auto;
    }
    .recap-photo-label {
      bottom: 14px;
      left: 14px;
    }
  }
</style>
