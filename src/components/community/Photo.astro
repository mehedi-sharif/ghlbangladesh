---
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  class?: string;
  sizes?: string;
}
const {
  name,
  alt,
  eager = false,
  class: className = "",
  sizes = "(max-width: 760px) 100vw, 50vw",
} = Astro.props;
---

<img
  class={className}
  src={`/images/community/${name}-1200.webp`}
  srcset={`/images/community/${name}-640.webp 640w, /images/community/${name}-1200.webp 1200w, /images/community/${name}-1800.webp 1800w`}
  sizes={sizes}
  width="1800"
  height="1201"
  alt={alt}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding="async"
/>
