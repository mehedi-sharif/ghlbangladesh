---
import { resources } from "../../data/community";
const resourceLabels: Record<string, string> = {
  "GET UNSTUCK": "Get unstuck",
  "EXPLORE THE PLATFORM": "Explore the platform",
  "BUILD YOUR SKILLS": "Build your skills",
  "STAY IN THE LOOP": "Stay in the loop",
};
const arrow = "M4.5 11.5 11.5 4.5M5.5 4.5h6v6";
---

<!-- one tile per resource; each colour of the logo marks one of them -->
<div class="resource-list">
  {
    resources.map((r) => (
      <a
        class="resource-tile reveal"
        href={r.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="resource-top">
          <span class="resource-number">{r.number}</span>
          <span class="resource-chip" aria-hidden="true">
            {[0, 1].map(() => (
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={arrow} />
              </svg>
            ))}
          </span>
        </span>
        <span class="resource-label">{resourceLabels[r.type] ?? r.type}</span>
        <h3>{r.title}</h3>
        <p>{r.description}</p>
        <span class="resource-host">{new URL(r.url).hostname}</span>
      </a>
    ))
  }
</div>

<style>
  .resource-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 20px);
  }
  .resource-tile {
    --accent: var(--yellow);
    --accent-ink: #b08f00;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(24px, 3vw, 36px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -55px rgba(6, 29, 48, 0.45);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      border-color 0.3s ease;
  }
  .resource-tile:nth-child(2) {
    --accent: var(--blue);
    --accent-ink: #1488c4;
  }
  .resource-tile:nth-child(3) {
    --accent: var(--green);
    --accent-ink: #07a944;
  }
  .resource-tile:nth-child(4) {
    --accent: var(--bd-red);
    --accent-ink: #d61f35;
  }
  :global(:root[data-theme="dark"]) .resource-tile {
    --accent-ink: var(--accent);
  }
  /* colour bar along the top */
  .resource-tile::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--accent);
  }
  .resource-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
  }
  /* large outlined number in the tile's colour */
  .resource-number {
    font-family: var(--display);
    font-size: clamp(44px, 4.4vw, 60px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent-ink);
  }
  .resource-chip {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--ink);
    color: var(--card);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .resource-chip svg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    transition: transform 0.45s var(--ease);
  }
  .resource-chip svg + svg {
    transform: translate(-250%, 250%);
  }
  .resource-label {
    margin-top: 22px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .resource-tile h3 {
    margin-top: 8px;
    font-family: var(--display);
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .resource-tile p {
    margin: 10px 0 0;
    max-width: 380px;
    color: var(--ink-2);
    font-size: 15.5px;
  }
  .resource-host {
    margin-top: auto;
    padding-top: 22px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .resource-tile:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .resource-tile:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    }
    .resource-tile:hover .resource-chip {
      background: var(--green);
      color: #04240f;
    }
    .resource-tile:hover .resource-chip svg:first-child {
      transform: translate(250%, -250%);
    }
    .resource-tile:hover .resource-chip svg + svg {
      transform: none;
    }
  }
  @media (max-width: 760px) {
    .resource-list {
      grid-template-columns: 1fr;
    }
  }
</style>
