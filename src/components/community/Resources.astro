---
import Arrow from "./Arrow.astro";
import { resources } from "../../data/community";
---

<div class="resource-list">
  {
    resources.map((r) => (
      <a
        class="resource-row"
        href={r.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <>
          <span class="resource-number">{r.number}</span>
          <div>
            <>
              <span class="eyebrow">{r.type}</span>
              <h3>{r.title}</h3>
              <p>{r.description}</p>
            </>
          </div>
          <span class="resource-arrow">
            <Arrow />
          </span>
        </>
      </a>
    ))
  }
</div>
