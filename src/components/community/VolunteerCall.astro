---
import BangladeshMap from "./BangladeshMap.astro";
import Button from "./Button.astro";
// Wording follows the volunteers page: roles are not open yet, so nothing is promised.
---

<section
  class="volunteer-call"
  id="volunteer"
  aria-labelledby="volunteer-call-heading"
>
  <div class="wrap volunteer-inner">
    <div class="volunteer-copy reveal">
      <h2 id="volunteer-call-heading">
        Volunteer <span class="no-break">with us.</span>
      </h2>
      <span class="volunteer-status"
        ><span class="volunteer-dot" aria-hidden="true"></span>Opening soon</span
      >
      <p class="volunteer-lead">
        We’ll open volunteer opportunities very soon.
      </p>
      <p class="volunteer-description">
        We’ll share the available roles and how to get involved when
        opportunities open.
      </p>
      <div class="volunteer-actions">
        <Button variant="outline" label="Volunteer page" href="/volunteers" />
      </div>
    </div>

    <div class="volunteer-map reveal">
      <BangladeshMap />
    </div>
  </div>
</section>

<style>
  .volunteer-call {
    padding: clamp(16px, 3vw, 40px) 0 clamp(72px, 9vw, 120px);
  }
  .volunteer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  /* same size as the other section headings: 72px on desktop */
  .volunteer-copy h2 {
    margin-top: 18px;
    font-size: clamp(38px, 5vw, 72px);
    line-height: 1.04;
  }
  .no-break {
    white-space: nowrap;
  }
  .volunteer-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .volunteer-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .volunteer-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: volunteer-pulse 2.4s ease-out infinite;
  }
  @keyframes volunteer-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--yellow) 60%, transparent);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  .volunteer-lead {
    margin: 18px 0 0;
    max-width: 520px;
    font-family: var(--display);
    font-size: clamp(18px, 1.6vw, 21px);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  .volunteer-description {
    margin: 8px 0 0;
    max-width: 520px;
    color: var(--ink-2);
  }
  .volunteer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 26px;
  }
  .volunteer-actions :global(.btn) {
    flex: none;
  }
  /* the GHL Bangladesh emblem as a dotted map */
  .volunteer-map {
    justify-self: center;
    width: 100%;
    max-width: 470px;
  }
  @media (max-width: 760px) {
    .volunteer-inner {
      grid-template-columns: 1fr;
    }
    .volunteer-map {
      max-width: 260px;
      justify-self: start;
    }
  }
</style>
