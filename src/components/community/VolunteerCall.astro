---
import Button from "./Button.astro";
import { groupUrl } from "../../data/community";
// Wording follows the volunteers page: roles are not open yet, so nothing is promised.
---

<section
  class="volunteer-call"
  id="volunteer"
  aria-labelledby="volunteer-call-heading"
>
  <div class="wrap volunteer-inner reveal">
    <div class="volunteer-title">
      <span class="kicker">Become a volunteer</span>
      <h2 id="volunteer-call-heading">
        Volunteer <span class="grad-text">with us.</span>
      </h2>
    </div>

    <!-- a slowly turning stamp around a pulsing dot: opportunities are opening soon -->
    <div class="volunteer-stamp" aria-hidden="true">
      <svg viewBox="0 0 160 160">
        <defs>
          <path
            id="volunteer-ring"
            d="M80 80m-62 0a62 62 0 1 1 124 0a62 62 0 1 1-124 0"></path>
        </defs>
        <circle class="stamp-line" cx="80" cy="80" r="76"></circle>
        <text
          ><textPath
            href="#volunteer-ring"
            textLength="386"
            lengthAdjust="spacing">Opening soon · Volunteer with us ·</textPath
          ></text
        >
      </svg>
      <span class="stamp-dot"></span>
    </div>

    <div class="volunteer-copy">
      <p class="volunteer-status">Opening soon.</p>
      <p class="volunteer-lead">
        We’ll open volunteer opportunities very soon.
      </p>
      <p class="volunteer-description">
        We’ll share the available roles and how to get involved when
        opportunities open.
      </p>
      <div class="volunteer-actions">
        <Button
          variant="outline"
          label="Get community updates"
          href={groupUrl}
        />
        <a class="volunteer-more" href="/volunteers">Volunteers page</a>
      </div>
    </div>
  </div>
</section>

<style>
  .volunteer-call {
    padding: clamp(24px, 4vw, 56px) 0 clamp(72px, 9vw, 120px);
  }
  .volunteer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) auto minmax(0, 1.15fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  .volunteer-title h2 {
    margin-top: 18px;
    font-size: clamp(44px, 6.6vw, 96px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }
  .volunteer-title h2 .grad-text {
    display: inline-block;
    padding-bottom: 0.06em;
  }

  /* rotating stamp */
  .volunteer-stamp {
    position: relative;
    width: clamp(132px, 12vw, 168px);
    aspect-ratio: 1;
  }
  .volunteer-stamp svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: stamp-turn 24s linear infinite;
  }
  .stamp-line {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }
  .volunteer-stamp text {
    fill: var(--ink-2);
    font-family: var(--body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  @keyframes stamp-turn {
    to {
      transform: rotate(360deg);
    }
  }
  .stamp-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--yellow) 18%, transparent);
  }
  .stamp-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: stamp-pulse 2.4s ease-out infinite;
  }
  @keyframes stamp-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--yellow) 55%, transparent);
    }
    100% {
      box-shadow: 0 0 0 26px transparent;
    }
  }

  /* the stamp says "opening soon" visually; this line says it for screen readers */
  .volunteer-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .volunteer-lead {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  .volunteer-description {
    margin: 10px 0 0;
    color: var(--ink-2);
  }
  .volunteer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 26px;
  }
  .volunteer-actions :global(.btn) {
    flex: none;
  }
  .volunteer-more {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  @media (max-width: 1000px) {
    .volunteer-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .volunteer-copy {
      grid-column: 1 / -1;
    }
  }
  /* phones: a smaller stamp sits beside the heading */
  @media (max-width: 560px) {
    .volunteer-stamp {
      width: 92px;
      align-self: start;
    }
    .volunteer-stamp text {
      font-size: 14px;
    }
  }
</style>
