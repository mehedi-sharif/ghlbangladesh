---
import Photo from "../Photo.astro";
import Pill from "./Pill.astro";
import { photos, albumUrl } from "../../../data/community";
// All 20 meetup photos, group photo first. Same tile plan as the live
// homepage gallery: two large tiles and six wide tiles in a four-column grid.
const featured = "meetup";
const list = [
  ...photos.filter((p) => p.name === featured),
  ...photos.filter((p) => p.name !== featured),
];
const tiles: Record<string, "big" | "wide"> = {
  meetup: "big",
  dsc08501: "big",
  dsc08436: "wide",
  dsc08636: "wide",
  dsc08546: "wide",
  dsc08489: "wide",
  dsc08339: "wide",
  dsc08260: "wide",
};
const sizes = {
  big: "(max-width: 760px) calc(100vw - 32px), 620px",
  wide: "(max-width: 760px) calc(100vw - 32px), 620px",
  single: "(max-width: 760px) 50vw, 310px",
};
---

<section
  class="v3-section gallery"
  id="gallery"
  aria-labelledby="gallery-heading"
>
  <div class="v3-wrap">
    <div class="gallery-head v3-reveal">
      <div>
        <span class="v3-kicker" style="--k: var(--yellow)"
          >Offline connections. Lasting impact.</span
        >
        <h2 id="gallery-heading" class="v3-h2">
          See you at the <span class="soft">next conversation.</span>
        </h2>
      </div>
      <div class="gallery-meta">
        <p>
          <strong>GHL Meetup Bangladesh 2026</strong>
          <span>{list.length} photos</span>
        </p>
        <Pill
          size="sm"
          variant="dark"
          label="Explore the full event album"
          href={albumUrl}
          aria-label="Explore the full event album (opens in a new tab)"
        />
      </div>
    </div>

    <ul class="grid" role="list" data-viewer-list>
      {
        list.map((photo, index) => (
          <li
            class:list={[
              "tile",
              "v3-reveal",
              tiles[photo.name] && `tile-${tiles[photo.name]}`,
            ]}
          >
            <a
              href={`/images/community/${photo.name}-1800.webp`}
              data-viewer-item
              data-caption={photo.caption}
              aria-label={`Enlarge photo: ${photo.alt}`}
              aria-haspopup="dialog"
              aria-controls="v3-viewer"
            >
              <Photo
                name={photo.name}
                alt={photo.alt}
                sizes={sizes[tiles[photo.name] ?? "single"]}
              />
              <span class="tile-caption" aria-hidden="true">
                <span class="tile-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {photo.caption}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog
    class="viewer v3-dark"
    id="v3-viewer"
    aria-labelledby="v3-viewer-title"
    aria-describedby="v3-viewer-caption"
  >
    <div class="viewer-bar">
      <h3 id="v3-viewer-title">
        GHL Meetup Bangladesh 2026 <span class="viewer-count"></span>
      </h3>
      <Pill
        class="viewer-close"
        size="sm"
        variant="dark"
        icon="x"
        label="Close"
        aria-label="Close photo viewer"
        autofocus
      />
    </div>
    <div class="viewer-stage">
      <img
        class="viewer-img"
        src="/images/community/meetup-1200.webp"
        alt="GHL Bangladesh meetup photo"
      />
    </div>
    <div class="viewer-foot">
      <p id="v3-viewer-caption" aria-live="polite"></p>
      <div class="viewer-nav">
        <Pill
          class="viewer-prev"
          size="sm"
          variant="dark"
          icon="left"
          iconFirst
          label="Previous"
          aria-label="Previous photo"
        />
        <Pill
          class="viewer-next"
          size="sm"
          variant="dark"
          icon="right"
          label="Next"
          aria-label="Next photo"
        />
      </div>
    </div>
  </dialog>
</section>

<script>
  // Photo viewer. Without scripts every photo opens as a normal link.
  const dialog = document.querySelector<HTMLDialogElement>("#v3-viewer");
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-viewer-item]"),
  );
  const image = dialog?.querySelector<HTMLImageElement>(".viewer-img");
  const caption = dialog?.querySelector<HTMLElement>("#v3-viewer-caption");
  const count = dialog?.querySelector<HTMLElement>(".viewer-count");
  if (
    dialog &&
    image &&
    caption &&
    count &&
    links.length &&
    typeof dialog.showModal === "function"
  ) {
    let active = 0;
    let opener: HTMLAnchorElement | null = null;
    const show = (index: number) => {
      active = (index + links.length) % links.length;
      const link = links[active];
      image.src = link.href;
      image.alt =
        link.querySelector("img")?.alt || "GHL Bangladesh meetup photo";
      caption.textContent = link.dataset.caption || "";
      count.textContent = `${active + 1} / ${links.length}`;
      // warm the next photo so stepping through feels instant
      const next = links[(active + 1) % links.length];
      new Image().src = next.href;
    };
    links.forEach((link, index) =>
      link.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        event.preventDefault();
        opener = link;
        show(index);
        dialog.showModal();
      }),
    );
    dialog
      .querySelector(".viewer-close")
      ?.addEventListener("click", () => dialog.close());
    dialog
      .querySelector(".viewer-prev")
      ?.addEventListener("click", () => show(active - 1));
    dialog
      .querySelector(".viewer-next")
      ?.addEventListener("click", () => show(active + 1));
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        show(active + (event.key === "ArrowLeft" ? -1 : 1));
      }
    });
    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.classList.contains("viewer-stage"))
        dialog.close();
    });
    // swipe left or right on touch screens
    let startX = 0;
    dialog.addEventListener(
      "touchstart",
      (event) => (startX = event.touches[0].clientX),
      { passive: true },
    );
    dialog.addEventListener("touchend", (event) => {
      const dx = event.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(active + (dx < 0 ? 1 : -1));
    });
    dialog.addEventListener("close", () => {
      if (opener?.isConnected) opener.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .gallery {
    border-top: 1px solid var(--line);
    background:
      linear-gradient(180deg, var(--strip-bg), transparent 420px), var(--bg);
  }
  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .gallery-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .gallery-meta p {
    display: grid;
    line-height: 1.35;
    text-align: right;
  }
  .gallery-meta strong {
    font-size: 14px;
    font-weight: 700;
  }
  .gallery-meta span {
    color: var(--text-3);
    font-size: 13px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 10px;
    margin-top: clamp(32px, 5vw, 56px);
  }
  .tile {
    aspect-ratio: 3 / 2;
  }
  .tile-big {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }
  .tile-wide {
    grid-column: span 2;
    aspect-ratio: 3 / 1;
  }
  .tile a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface);
    cursor: zoom-in;
  }
  .tile a::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid var(--line);
    border-radius: inherit;
    pointer-events: none;
    transition: border-color 0.3s;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s var(--ease),
      filter 0.4s;
  }
  .tile-caption {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: baseline;
    gap: 10px;
    width: fit-content;
    max-width: calc(100% - 20px);
    padding: 7px 12px;
    border-radius: 10px;
    background: rgba(3, 14, 24, 0.8);
    color: #f1f5f8;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease);
  }
  .tile-index {
    color: var(--yellow);
    font-size: 11px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .tile a:hover :global(img),
  .tile a:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .tile a:hover::after,
  .tile a:focus-visible::after {
    border-color: rgba(255, 255, 255, 0.35);
  }
  .tile a:hover .tile-caption,
  .tile a:focus-visible .tile-caption {
    opacity: 1;
    transform: none;
  }
  .tile a:focus-visible {
    outline-offset: 2px;
    border-radius: 16px;
  }
  /* touch screens have no hover, so captions of the large tiles stay visible */
  @media (hover: none) {
    .tile-big .tile-caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .tile-wide,
    .tile-big {
      aspect-ratio: 3 / 2;
    }
    .tile-big {
      grid-row: span 1;
    }
    .tile a {
      border-radius: 12px;
    }
    .gallery-meta p {
      text-align: left;
    }
  }

  /* Viewer */
  .viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #020910;
    color: var(--text);
    font-family: var(--font);
  }
  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    animation: viewer-in 0.3s var(--ease);
  }
  .viewer::backdrop {
    background: rgba(2, 9, 16, 0.7);
  }
  @keyframes viewer-in {
    from {
      opacity: 0;
    }
  }
  .viewer-bar,
  .viewer-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: min(1240px, 100% - 32px);
    margin-inline: auto;
    padding-block: 14px;
  }
  .viewer-bar h3 {
    font-size: 15px;
    font-weight: 700;
  }
  .viewer-count {
    margin-left: 8px;
    color: var(--text-3);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .viewer-stage {
    position: relative;
    min-height: 0;
    padding-inline: 16px;
  }
  .viewer-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .viewer-foot p {
    color: var(--text-2);
    font-size: 15px;
  }
  .viewer-nav {
    display: flex;
    gap: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile :global(img),
    .tile-caption {
      transition: none;
    }
    .viewer[open] {
      animation: none;
    }
  }
</style>
