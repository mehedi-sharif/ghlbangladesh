<style>
  .scene {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .island {
    animation: float 7s ease-in-out infinite;
  }
  .island :global(.bub1) {
    animation: bob 4s ease-in-out infinite;
  }
  .island :global(.bub2) {
    animation: bob 4s ease-in-out 1.3s infinite;
  }
  .island :global(.tile1),
  .island :global(.tile3) {
    animation: bob 6s ease-in-out 0.6s infinite;
  }
  .island :global(.tile2) {
    animation: bob 5s ease-in-out 2s infinite;
  }
  /* the arrows grow up from the island on load */
  .island :global(.ar) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .island :global(.ar2) {
    animation-delay: 0.12s;
  }
  .island :global(.ar3) {
    animation-delay: 0.24s;
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }
  @keyframes rise {
    from {
      transform: scaleY(0.15);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .island,
    .island :global(*) {
      animation: none !important;
    }
  }
</style>
