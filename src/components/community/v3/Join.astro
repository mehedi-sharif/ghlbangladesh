---
import Pill from "./Pill.astro";
import Spot from "./Spot.astro";
import { groupUrl } from "../../../data/community";
// Closing invitation, centred like the section titles. The three rising
// arrows of the GHL logo, drawn in 3D, grow into place above the heading.
---

<section class="v3-section join" id="join" aria-labelledby="join-heading">
  <div class="v3-wrap">
    <div class="join-card v3-reveal">
      <div class="join-art">
        <Spot name="arrows" />
        <span class="join-floor" aria-hidden="true"></span>
      </div>
      <h2 id="join-heading">
        Great things start with a <span class="soft">connection.</span>
      </h2>
      <Pill
        size="lg"
        variant="green"
        label="Join the community"
        href={groupUrl}
      />
    </div>
  </div>
</section>

<style>
  .join {
    padding-top: 0;
  }
  .join-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: clamp(40px, 6vw, 72px) clamp(20px, 5vw, 64px)
      clamp(48px, 6vw, 80px);
    border: 1px solid var(--line-2);
    border-radius: calc(var(--radius) + 8px);
    background:
      radial-gradient(
          circle at 1px 1px,
          rgba(196, 226, 255, 0.08) 1px,
          transparent 1.5px
        )
        0 0 / 22px 22px,
      var(--surface);
    text-align: center;
  }
  /* a fixed, modest size so the arrows support the heading instead of
     filling the card */
  .join-art {
    position: relative;
    width: clamp(120px, 14vw, 168px);
  }
  .join-art :global(.spot) {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  /* soft shadow the arrows stand on */
  .join-floor {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -6px;
    height: 18px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    filter: blur(8px);
  }
  h2 {
    max-width: 16ch;
    font-size: clamp(34px, 5vw, 64px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  h2 .soft {
    color: var(--text-3);
  }

  /* the arrows grow in once the card is on screen */
  .join-card :global(.ar) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform 0.9s var(--ease);
  }
  .join-card :global(.ar2) {
    transition-delay: 0.12s;
  }
  .join-card :global(.ar3) {
    transition-delay: 0.24s;
  }
  :global(.js) .join-card:not(.in) :global(.ar) {
    transform: scaleY(0.2);
  }
  @media (prefers-reduced-motion: reduce) {
    .join-card :global(.ar) {
      transition: none;
    }
    :global(.js) .join-card:not(.in) :global(.ar) {
      transform: none;
    }
  }
</style>
