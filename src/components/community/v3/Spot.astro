---
// Small original isometric illustrations for Home v3, in the same style as
// the hero scene: a calendar waiting for a date, a Bangladesh flag planted on
// three blocks, and the three logo arrows in 3D.
interface Props {
  name: "calendar" | "volunteer" | "arrows";
  class?: string;
}
const { name, class: className } = Astro.props;
const views = {
  calendar: "30 70 340 250",
  volunteer: "70 70 260 230",
  arrows: "60 40 300 330",
};
---

<svg
  class:list={["spot", `spot-${name}`, className]}
  viewBox={views[name]}
  aria-hidden="true"
  focusable="false"
>
  {
    name === "calendar" && (
      <Fragment
        set:html={`<polygon points="61.4,210.0 200.0,290.0 200.0,254.0 61.4,174.0" fill="#9fb3c4" /><polygon points="338.6,210.0 200.0,290.0 200.0,254.0 338.6,174.0" fill="#c5d3de" /><polygon points="200.0,94.0 338.6,174.0 200.0,254.0 61.4,174.0" fill="#f1f5f8" />
<polyline points="61.4,200.0 200.0,280.0 338.6,200.0" fill="none" stroke="#7d93a6" stroke-width="1"/>
<polyline points="61.4,190.0 200.0,270.0 338.6,190.0" fill="none" stroke="#7d93a6" stroke-width="1"/>
<polyline points="61.4,180.0 200.0,260.0 338.6,180.0" fill="none" stroke="#7d93a6" stroke-width="1"/>
<polygon points="161.9,116.0 300.5,196.0 300.5,182.0 161.9,102.0" fill="#b81c2f" /><polygon points="338.6,174.0 300.5,196.0 300.5,182.0 338.6,160.0" fill="#d22237" /><polygon points="200.0,80.0 338.6,160.0 300.5,182.0 161.9,102.0" fill="#f42a41" />
<polygon points="161.9,116.0 300.5,196.0 300.5,182.0 161.9,102.0" fill="#006a4e" /><polygon points="300.5,196.0 300.5,196.0 300.5,182.0 300.5,182.0" fill="#00513c" /><polygon points="161.9,102.0 300.5,182.0 300.5,182.0 161.9,102.0" fill="#006a4e" />
<text transform="matrix(0.866 0.5 -0.866 0.5 180.9 193.0)" text-anchor="middle" dominant-baseline="middle" font-family="Plus Jakarta Sans, sans-serif" font-weight="800" font-size="46" fill="#061d30" letter-spacing="-1">TBA</text>`}
      />
    )
  }
  {
    name === "volunteer" && (
      <Fragment
        set:html={`<polygon points="188.5,236.8 234.6,263.4 234.6,236.8 188.5,210.2" fill="#0bce55" /><polygon points="280.6,236.8 234.6,263.4 234.6,236.8 280.6,210.2" fill="#089a40" /><polygon points="234.6,183.6 280.6,210.2 234.6,236.8 188.5,210.2" fill="#6cf0a0" />
<polygon points="114.4,251.0 160.5,277.6 160.5,224.4 114.4,197.8" fill="#f8d325" /><polygon points="206.6,251.0 160.5,277.6 160.5,224.4 206.6,197.8" fill="#c9a50a" /><polygon points="160.5,171.2 206.6,197.8 160.5,224.4 114.4,197.8" fill="#ffe36b" />
<polygon points="163.8,279.5 209.9,306.1 209.9,226.3 163.8,199.7" fill="#20a9ed" /><polygon points="255.9,279.5 209.9,306.1 209.9,226.3 255.9,199.7" fill="#137fb6" /><polygon points="209.9,173.1 255.9,199.7 209.9,226.3 163.8,199.7" fill="#7fd0f7" />
<line x1="209.9" y1="199.7" x2="209.9" y2="104.7" stroke="#f1f5f8" stroke-width="4" stroke-linecap="round"/>
<g class="flag"><polygon points="209.9,104.7 269.1,138.9 269.1,184.5 209.9,150.3" fill="#006a4e" /><ellipse cx="236.2" cy="142.7" rx="11" ry="12" transform="skewY(30) translate(0 -136.3)" fill="#f42a41"/></g>`}
      />
    )
  }
  {
    name === "arrows" && (
      <Fragment
        set:html={`<g class="ar ar3"><polygon points="293.5,333.6 324.7,351.6 324.7,171.6 293.5,153.6" fill="#0bce55" /><polygon points="355.9,333.6 324.7,351.6 324.7,171.6 355.9,153.6" fill="#089a40" /><polygon points="324.7,135.6 355.9,153.6 324.7,171.6 293.5,153.6" fill="#6cf0a0" /><polygon points="307.6,125.7 373.0,163.5 341.9,181.5 276.4,143.7" fill="#089a40" /><polygon points="373.0,163.5 341.9,181.5 309.1,121.2 340.3,103.2" fill="#089a40" /><polygon points="276.4,143.7 341.9,181.5 309.1,121.2" fill="#0bce55" /><polygon points="307.6,125.7 276.4,143.7 309.1,121.2 340.3,103.2" fill="#6cf0a0" /><polygon points="276.4,143.7 341.9,181.5 309.1,121.2" fill="#0bce55" /></g>
<g class="ar ar2"><polygon points="200.0,333.6 231.2,351.6 231.2,229.2 200.0,211.2" fill="#20a9ed" /><polygon points="262.4,333.6 231.2,351.6 231.2,229.2 262.4,211.2" fill="#137fb6" /><polygon points="231.2,193.2 262.4,211.2 231.2,229.2 200.0,211.2" fill="#7fd0f7" /><polygon points="214.0,183.3 279.5,221.1 248.3,239.1 182.9,201.3" fill="#137fb6" /><polygon points="279.5,221.1 248.3,239.1 215.6,178.8 246.8,160.8" fill="#137fb6" /><polygon points="182.9,201.3 248.3,239.1 215.6,178.8" fill="#20a9ed" /><polygon points="214.0,183.3 182.9,201.3 215.6,178.8 246.8,160.8" fill="#7fd0f7" /><polygon points="182.9,201.3 248.3,239.1 215.6,178.8" fill="#20a9ed" /></g>
<g class="ar ar1"><polygon points="106.5,333.6 137.6,351.6 137.6,286.8 106.5,268.8" fill="#f8d325" /><polygon points="168.8,333.6 137.6,351.6 137.6,286.8 168.8,268.8" fill="#c9a50a" /><polygon points="137.6,250.8 168.8,268.8 137.6,286.8 106.5,268.8" fill="#ffe36b" /><polygon points="120.5,240.9 186.0,278.7 154.8,296.7 89.3,258.9" fill="#c9a50a" /><polygon points="186.0,278.7 154.8,296.7 122.1,236.4 153.2,218.4" fill="#c9a50a" /><polygon points="89.3,258.9 154.8,296.7 122.1,236.4" fill="#f8d325" /><polygon points="120.5,240.9 89.3,258.9 122.1,236.4 153.2,218.4" fill="#ffe36b" /><polygon points="89.3,258.9 154.8,296.7 122.1,236.4" fill="#f8d325" /></g>`}
      />
    )
  }
</svg>

<style>
  .spot {
    display: block;
    height: auto;
    overflow: visible;
  }
  .spot-volunteer :global(.flag) {
    transform-box: fill-box;
    transform-origin: 0 50%;
    animation: wave 3.2s ease-in-out infinite;
  }
  @keyframes wave {
    50% {
      transform: skewY(-4deg) scaleX(0.94);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spot :global(*) {
      animation: none !important;
    }
  }
</style>
