---
import Photo from "../Photo.astro";
// The origin story in Mehedi's own words, with the two co-organisers.
// Photos, alt texts, crop positions and Shariful's link match the live homepage.
const shariful = "https://www.facebook.com/vidmshariful";
---

<section
  class="v3-section story"
  id="our-story"
  aria-labelledby="story-heading"
>
  <div class="v3-wrap">
    <div class="story-panel v3-reveal">
      <div class="story-copy">
        <span class="v3-kicker" style="--k: var(--bd-red)">Our story</span>
        <h2 id="story-heading" class="v3-h2">How we started.</h2>
        <div class="story-text">
          <p class="story-first">
            GHL Bangladesh began with conversations between
            <a
              href={shariful}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Shariful Islam on Facebook (opens in a new tab)"
              ><strong>Shariful Islam</strong></a
            > and me. <span class="soft"
              >We kept talking about how many people in Bangladesh work with
              GoHighLevel every day, yet hardly ever meet in person. We wanted a
              chance to sit together, compare experiences, and get to know the
              people doing the same work.</span
            >
          </p>
          <p>
            So we decided to organise an unofficial, community-driven meetup.
            The idea was simple: GHL users in one room, asking questions and
            sharing what was actually working for them.
          </p>
          <p>
            Shariful and I organised that gathering together. For me, starting
            GHL Bangladesh was a way to make those conversations happen: people
            here meeting face to face, sharing practical knowledge, and learning
            from one another.
          </p>
        </div>
      </div>

      <div class="story-people" role="group" aria-label="Meetup co-organisers">
        <figure class="person person-mehedi">
          <div class="person-photo">
            <Photo
              name="dsc08548"
              alt="Mehedi Sharif seated with his phone at the GHL Bangladesh meetup"
              sizes="(max-width: 1000px) 45vw, 280px"
            />
          </div>
          <figcaption>
            <span class="person-dot" aria-hidden="true"></span>Mehedi Sharif
          </figcaption>
        </figure>
        <figure class="person person-shariful">
          <div class="person-photo">
            <Photo
              name="dsc08543"
              alt="Shariful Islam speaking into a microphone at the GHL Bangladesh meetup"
              width={1800}
              height={1201}
              sizes="(max-width: 1000px) 45vw, 280px"
            />
          </div>
          <figcaption>
            <span class="person-dot" aria-hidden="true"></span><a
              href={shariful}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Shariful Islam on Facebook (opens in a new tab)"
              >Shariful Islam</a
            >
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    padding-top: 0;
  }
  .story-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(24px, 5vw, 64px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 8px);
    background: var(--surface);
  }
  /* a thin flag-coloured rule along the top edge */
  .story-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--bd-green) 0 72%,
      var(--bd-red) 72% 80%,
      var(--bd-green) 80% 100%
    );
  }
  .story-text {
    display: grid;
    gap: 18px;
    margin-top: 32px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.75;
  }
  .story-first {
    color: var(--text);
    font-size: clamp(21px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
  .story-first .soft {
    color: var(--text-2);
    font-weight: 500;
  }
  .story-text a {
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: color 0.2s;
  }
  .story-text a:hover {
    color: var(--blue);
  }
  .story-text strong {
    font-weight: 800;
  }

  .story-people {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    align-self: center;
  }
  .person-shariful {
    margin-top: 64px;
  }
  .person-photo {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    background: var(--surface-2);
    box-shadow: 0 30px 60px -30px var(--shadow);
  }
  .person-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  /* individual crop positions keep each person in frame */
  .person-mehedi .person-photo :global(img) {
    object-position: 72% center;
  }
  .person-shariful .person-photo :global(img) {
    object-position: 62% center;
  }
  .person:hover .person-photo :global(img) {
    transform: scale(1.04);
  }
  .person figcaption {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 15px;
    font-weight: 700;
  }
  .person figcaption a {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }
  .person figcaption a:hover {
    text-decoration-color: currentColor;
  }
  .person-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }
  .person-shariful .person-dot {
    background: var(--blue);
  }

  @media (max-width: 1000px) {
    .story-panel {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .story-people {
      gap: 10px;
    }
    .person-shariful {
      margin-top: 40px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .person-photo :global(img) {
      transition: none;
    }
  }
</style>
