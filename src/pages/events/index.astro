---
import Layout from "../../layouts/CommunityLayout.astro";
import Photo from "../../components/community/Photo.astro";
import Join from "../../components/community/Join.astro";
import { groupUrl } from "../../data/community";
---

<Layout title="Meetups & Workshops — HighLevel Bangladesh"
  ><section class="page-hero wrap">
    <span class="eyebrow">Meetups &amp; workshops</span><h1>
      Let’s take the<br />conversation offline.
    </h1><p>
      Come for a new idea. Stay for the connections. Our local meetups bring the
      community together to learn, ask questions, and share.
    </p>
  </section><section class="events-section section">
    <div class="wrap event-feature">
      <a href="/events/meetup-2026" class="event-image"
        ><Photo
          name="meetup"
          alt="GHL Bangladesh meetup participants gathered together"
          eager
        /><span class="image-label">GHL Meetup Bangladesh 2026</span></a
      ><div class="event-content">
        <span class="eyebrow">Meetup photos</span><h2>
          GHL Meetup<br />Bangladesh 2026
        </h2><p>
          Group photos, presentations, and conversations from the Bangladesh
          meetup.
        </p><a class="text-link" href="/events/meetup-2026"
          >View the photo gallery</a>
      </div>
    </div>
  </section><section class="section wrap split-content">
    <div>
      <span class="eyebrow">Announcement coming soon</span><h2>
        Your next local<br />connection starts here.
      </h2>
    </div><div>
      <p class="large-copy">Date to be announced · Bangladesh</p><p>
        Details of the next Bangladesh chapter meetup will be shared here once
        confirmed.
      </p><a
        class="button"
        href={groupUrl}
        target="_blank"
        rel="noopener noreferrer">Get Event Updates</a>
    </div>
  </section><Join /></Layout
>
