---
import Layout from "../../layouts/CommunityLayout.astro";
import Join from "../../components/community/Join.astro";
import Photo from "../../components/community/Photo.astro";
import { photos, albumUrl } from "../../data/community";
---

<Layout title="GHL Meetup Bangladesh 2026 — Photo Gallery"
  ><section class="page-hero wrap">
    <a href="/events" class="back-link">← All events</a><span class="eyebrow"
      >GHL Bangladesh chapter</span
    ><h1>GHL Meetup<br />Bangladesh 2026.</h1><p>
      Group photos, presentations, and conversations from the Bangladesh meetup.
    </p>
  </section><section class="wrap gallery" aria-label="Meetup photo gallery">
    {
      photos.map((photo) => (
        <figure>
          <>
            <button
              class="gallery-photo"
              data-photo={`/images/community/${photo.name}-1800.webp`}
              aria-label={`Enlarge photo: ${photo.alt}`}
            >
              <Photo
                name={photo.name}
                alt={photo.alt}
                sizes={
                  photo.name === "meetup"
                    ? "90vw"
                    : "(max-width:760px) 90vw, 45vw"
                }
                eager={photo.name === "meetup"}
              />
            </button>
          </>
        </figure>
      ))
    }
  </section><div class="wrap section">
    <a
      class="text-link"
      href={albumUrl}
      target="_blank"
      rel="noopener noreferrer">Explore the full event album ↗</a
    >
  </div><Join /><dialog
    class="gallery-dialog"
    aria-label="Enlarged meetup photograph"
  >
    <div class="dialog-inner">
      <img
        id="dialog-photo"
        src="/images/community/meetup-1200.webp"
        alt="GHL Bangladesh meetup group photograph"
      /><div class="dialog-caption">
        <button class="dialog-close" autofocus>Close ✕</button>
      </div>
    </div>
  </dialog><script>
    const dialog = document.querySelector<HTMLDialogElement>(".gallery-dialog");
    const image = document.querySelector<HTMLImageElement>("#dialog-photo");
    document
      .querySelectorAll<HTMLButtonElement>(".gallery-photo")
      .forEach((button) =>
        button.addEventListener("click", () => {
          if (!dialog || !image) return;
          image.src = button.dataset.photo || "";
          image.alt = button.querySelector("img")?.alt || "";
          dialog.showModal();
        }),
      );
    document
      .querySelector(".dialog-close")
      ?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) {
        const rect = dialog.getBoundingClientRect();
        if (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        )
          dialog.close();
      }
    });
  </script></Layout
>

<style>
  .dialog-caption {
    justify-content: flex-end;
  }
</style>
