---
import Layout from "../layouts/CommunityLayout.astro";
import Join from "../components/community/Join.astro";
import AudienceStrip from "../components/community/AudienceStrip.astro";
import MeetupRecap from "../components/community/MeetupRecap.astro";
import CommunityOverview from "../components/community/CommunityOverview.astro";
import CommunityStory from "../components/community/CommunityStory.astro";
import ChapterLeader from "../components/community/ChapterLeader.astro";
import Button from "../components/community/Button.astro";
import EventsOverview from "../components/community/EventsOverview.astro";
import VolunteerCall from "../components/community/VolunteerCall.astro";
---

<Layout>
  <section class="chapter-hero" aria-labelledby="hero-heading">
    <div class="hero-media" aria-hidden="true">
      <video
        id="chapter-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/community/community.webp"
        ><source
          src="/images/community/chapter-meetup.mp4"
          type="video/mp4"
        /></video
      >
    </div>
    <div class="wrap hero-content">
      <span class="chapter-label"
        ><span class="flag-mark" aria-hidden="true"></span> Bangladesh local chapter</span
      >
      <h1 id="hero-heading">
        Learn. Connect. Grow. <span class="grad-text"
          >Together in Bangladesh.</span
        >
      </h1>
      <div class="hero-bottom">
        <p>
          <strong>A local home for people building with HighLevel.</strong> Meet your
          peers, share what works, and take the next step together.
        </p>
        <Button
          variant="ghost"
          size="lg"
          icon="down"
          glyph="↓"
          label="Explore Events"
          href="#events"
        />
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true">Scroll</span>
  </section>
  <AudienceStrip />
  <CommunityOverview />
  <EventsOverview />
  <MeetupRecap />
  <CommunityStory />
  <ChapterLeader />
  <VolunteerCall />
  <Join />
  <script>
    const video = document.querySelector<HTMLVideoElement>("#chapter-video");
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    if (video) {
      video.muted = true;
      video.defaultMuted = true;
      const sync = () => {
        if (motion.matches || document.hidden) {
          video.pause();
          return;
        }
        video.play().catch(() => {});
      };
      video.addEventListener("loadeddata", sync, { once: true });
      document.addEventListener("visibilitychange", sync);
      motion.addEventListener("change", sync);
      sync();
    }

    // Gentle parallax: the video drifts down and the text fades up while the hero scrolls away.
    const hero = document.querySelector<HTMLElement>(".chapter-hero");
    const media = document.querySelector<HTMLElement>(".hero-media");
    const content = document.querySelector<HTMLElement>(".hero-content");
    if (hero && media && content && !motion.matches) {
      let ticking = false;
      const paint = () => {
        ticking = false;
        const y = window.scrollY;
        const height = hero.offsetHeight;
        if (y < height) {
          media.style.setProperty("--py", (y * 0.18).toFixed(1) + "px");
          content.style.setProperty("--cy", (y * -0.12).toFixed(1) + "px");
          content.style.setProperty(
            "--co",
            Math.max(0, 1 - y / (height * 0.75)).toFixed(3),
          );
        }
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(paint);
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      paint();
    }
  </script>
</Layout>
