---
import Layout from "../layouts/CommunityLayout.astro";
import Arrow from "../components/community/Arrow.astro";
import Join from "../components/community/Join.astro";
import { groupUrl } from "../data/community";
const resources = [
  {
    label: "Support",
    title: "Help Center",
    text: "Guides and answers, step by step.",
    url: "https://help.gohighlevel.com/",
  },
  {
    label: "Explore",
    title: "Discover HighLevel",
    text: "Get to know the platform.",
    url: "https://www.gohighlevel.com/",
  },
  {
    label: "Skills",
    title: "Certification",
    text: "Take your knowledge further.",
    url: "https://www.gohighlevel.com/certifications",
  },
  {
    label: "What’s new",
    title: "Product Updates",
    text: "See what’s new in HighLevel.",
    url: "https://ideas.gohighlevel.com/changelog",
  },
];
---

<Layout>
  <section class="chapter-hero" aria-labelledby="hero-heading">
    <div class="hero-media" aria-hidden="true">
      <video
        id="chapter-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/community/community.webp"
        ><source
          src="/images/community/chapter-meetup.mp4"
          type="video/mp4"
        /></video
      >
    </div><div class="wrap hero-content">
      <span class="eyebrow chapter-label"
        ><span class="flag-mark" aria-hidden="true"></span> Bangladesh local chapter</span
      ><h1 id="hero-heading">
        Learn. Connect.{" "}<br />Grow. <span
          >Together{" "}<br class="hero-break" /> in Bangladesh.</span
        >
      </h1><p>
        A local home for people building with HighLevel.{" "}<br
          class="desktop-only"
        /> Meet your peers, share what works, and take the next step together.
      </p><div class="hero-actions">
        <a
          class="button button-green"
          href={groupUrl}
          target="_blank"
          rel="noopener noreferrer">Join the Community <Arrow /></a
        ><a class="button button-outline" href="#events"
          >Explore Events <span aria-hidden="true">↓</span></a
        >
      </div>
    </div><div class="wrap hero-foot">
      <p>
        For agency owners, developers,{" "}<br class="mobile-only" /> marketers &amp;
        entrepreneurs
      </p><button
        class="video-toggle"
        aria-label="Pause background video"
        type="button"
        hidden
        ><svg
          class="pause-symbol"
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="currentColor"
          aria-hidden="true"><path d="M3 2h3v10H3zM8 2h3v10H8z"></path></svg
        ><span>Pause video</span></button
      >
    </div>
  </section>
  <section class="section wrap community-intro" id="community">
    <div class="intro-title">
      <span class="eyebrow">A stronger local community</span><h2>
        Big ideas.{" "}<br />Local connections.
      </h2>
    </div><div class="intro-copy">
      <p class="lead">You don’t have to figure it all out alone.</p><p>
        Connect with people in Bangladesh who understand the tools, the
        challenges, and the possibilities.
      </p><p>
        We’re here to share practical knowledge, learn from each other, and turn
        online connections into real conversations.
      </p><a class="text-link" href="#benefits"
        >Find your place here <span aria-hidden="true">↓</span></a
      >
    </div><figure class="chapter-group-photo">
      <img
        src="/images/community/community.webp"
        srcset="/images/community/community-800.webp 800w, /images/community/community.webp 1600w"
        sizes="(max-width:760px) 100vw, 90vw"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
        alt="Members of the HighLevel Bangladesh community gathered at the meetup"
      /><figcaption>
        <span>The HighLevel Bangladesh community</span><a
          href="/events/meetup-2026">See the meetup photos <Arrow /></a
        >
      </figcaption>
    </figure>
  </section>
  <section class="benefits-section" id="benefits">
    <div class="wrap benefit-layout">
      <div class="benefit-intro">
        <span class="eyebrow">Built around you</span><h2>
          Better when{" "}<br />we build{" "}<br />together.
        </h2><p>
          Practical learning. Open conversations. People who get it.
        </p><img
          src="/images/community/conversations-640.webp"
          width="640"
          height="427"
          loading="lazy"
          alt="Members sharing a conversation at the Bangladesh meetup"
        />
      </div><div class="benefit-rows">
        <article>
          <span class="benefit-number">01</span><div>
            <h3>Learn.</h3><p>
              Explore real use cases through workshops, live demos, and shared
              experience.
            </p>
          </div>
        </article><article>
          <span class="benefit-number">02</span><div>
            <h3>Connect.</h3><p>
              Meet local users, exchange ideas, and find people to collaborate
              with.
            </p>
          </div>
        </article><article>
          <span class="benefit-number">03</span><div>
            <h3>Grow.</h3><p>
              Build your confidence, sharpen your skills, and discover new
              opportunities.
            </p>
          </div>
        </article><p class="audience">
          Just getting started or already building?{" "}<br /><strong
            >You’re welcome here.</strong
          >
        </p>
      </div>
    </div>
  </section>
  <section class="section wrap event-section" id="events">
    <div class="event-intro">
      <span class="eyebrow">Meetups &amp; workshops</span><h2>
        Let’s take the{" "}<br />conversation{" "}<br />offline.
      </h2><p>Come for a new idea. Stay for the connections.</p><p>
        Our local meetups bring the community together to learn, ask questions,
        and share.
      </p><a class="text-link" href="/events/meetup-2026"
        >Inside our last meetup <Arrow /></a
      >
    </div><article class="event-card">
      <div class="event-card-top">
        <span class="eyebrow">Bangladesh chapter</span><svg
          width="40"
          height="40"
          viewBox="0 0 40 40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><rect x="5" y="8" width="30" height="27" rx="2"></rect><path
            d="M5 17h30M13 4v9M27 4v9M12 24h5M23 24h5M12 29h5"></path></svg
        >
      </div><span class="event-status">Announcement coming soon</span><h3>
        Your next local{" "}<br />connection starts here.
      </h3><p>
        Details of the next Bangladesh chapter meetup will be shared here once
        confirmed.
      </p><div class="event-meta">
        <span>Date to be announced</span><span>Bangladesh</span>
      </div><a
        class="button"
        href={groupUrl}
        target="_blank"
        rel="noopener noreferrer">Get Event Updates <Arrow /></a
      >
    </article>
  </section>
  <section class="resources-section" id="resources">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Keep learning</span><h2>
            A few good{" "}<br />places to start.
          </h2>
        </div><p>Useful HighLevel resources.{" "}<br />All in one place.</p>
      </div><div class="resource-grid">
        {
          resources.map((r) => (
            <a
              class="resource"
              href={r.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <>
                <div class="resource-top">
                  <>
                    <span>{r.label}</span>
                    <Arrow />
                  </>
                </div>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="leader-section wrap">
    <div class="leader-photo">
      <img
        src="/images/community/mehedi.webp"
        alt="Mehedi Sharif speaking at the GHL Bangladesh meetup"
        width="400"
        height="357"
        loading="lazy"
      /><span class="photo-note">From our Bangladesh meetup</span>
    </div><div class="leader-copy">
      <span class="eyebrow">Meet your chapter leader</span><h2>
        Mehedi{" "}<br />Sharif.
      </h2><p>
        A local point of connection for Bangladesh’s HighLevel community.
      </p><p class="credentials">
        HighLevel Certified Admin{" "}<br />Founder &amp; Investor
      </p><a
        class="text-link"
        href="https://www.facebook.com/mehedi.sharif.titas"
        target="_blank"
        rel="noopener noreferrer">Connect with Mehedi <Arrow /></a
      >
    </div>
  </section>
  <Join />
  <script>
    const video = document.querySelector<HTMLVideoElement>("#chapter-video");
    const toggle = document.querySelector<HTMLButtonElement>(".video-toggle");
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let userPaused = false;
    if (video && toggle) {
      video.muted = true;
      video.defaultMuted = true;
      const update = () => {
        const paused = video.paused;
        const label = paused ? "Play video" : "Pause video";
        const text = toggle.querySelector("span");
        if (text) text.textContent = label;
        toggle.setAttribute(
          "aria-label",
          paused ? "Play background video" : "Pause background video",
        );
        toggle.dataset.paused = String(paused);
      };
      const sync = () => {
        if (motion.matches || userPaused || document.hidden) {
          video.pause();
          update();
          return;
        }
        video.play().then(update).catch(update);
      };
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        if (video.paused) {
          userPaused = false;
          video.play().then(update).catch(update);
        } else {
          userPaused = true;
          video.pause();
        }
      });
      video.addEventListener("play", update);
      video.addEventListener("pause", update);
      video.addEventListener("loadeddata", sync, { once: true });
      document.addEventListener("visibilitychange", sync);
      motion.addEventListener("change", sync);
      sync();
    }
  </script>
</Layout>
