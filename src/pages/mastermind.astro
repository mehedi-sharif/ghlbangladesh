const benefits = [
  {
    title: "Private Mastermind Calls",
    Icon: LuMessagesSquare,
    color: "green",
    points: [
      "Join a private call with experienced members each week.",
      "Get feedback on your business problems.",
      "Discuss prices, daily work, and ways to grow your business.",
    ],
  },
  {
    title: "Exclusive Expert Sessions",
