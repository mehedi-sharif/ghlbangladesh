---

<Layout
  title={name}
  description={lead}
  socialImage="/images/community/mastermind-og.jpg"
  socialImageAlt="GoHighLevel Bangladesh Mastermind. Let’s Scale Together."
>
  <div class="mastermind-intro">
    <PageIntro
      title="GoHighLevel Bangladesh"
      accent="Mastermind"
      lead={lead}
      photo="dsc08463"
      focus="center 42%"
    >
      <div class="intro-actions">
        <Button
          href={applicationUrl}
          label="Apply for Membership"
          data-membership-open
          aria-haspopup="dialog"
          aria-controls="membership-dialog"
        />
      </div>
    </PageIntro>
  </div>

  <section class="wrap mastermind-audience" aria-labelledby="audience-heading">
    <div>
      <h2 id="audience-heading">Let’s Scale Together</h2>
      <p>
        You’ve worked hands-on with HighLevel for about <strong
          >five or six years</strong
        >. You’ve built complex automations and handled large projects. You may
        have served
        <strong>100 or more clients</strong>, helped launch businesses, or built
        one of your own.
      </p>
      <p>
        You’ve done well on your own. When growth slows or your next step feels
        unclear, it helps to talk with people who do similar work. The
        Mastermind gives you a place to share what you’ve learned, hear what’s
        worked for others, and keep learning together.
      </p>
    </div>
    <img
      class="audience-photo"
      src="/images/community/mastermind-connection.webp"
      srcset="/images/community/mastermind-connection-640.webp 640w, /images/community/mastermind-connection.webp 1272w"
      sizes="(max-width: 840px) min(calc(100vw - 96px), 560px), 38vw"
      width="1272"
      height="1194"
      alt="Several people resting their hands on the same tree branch"
      loading="lazy"
      decoding="async"
    />
  </section>

  <section
    class="wrap mastermind-benefits"
    aria-labelledby="membership-benefits"
  >
    <h2 id="membership-benefits">What You Get as a Member</h2>
    <ol class="benefit-grid" role="list">
      {
        benefits.map(({ title, Icon, color, points }) => (
          <li class="benefit">
            <span class="benefit-icon" data-color={color} aria-hidden="true">
              <Icon size={28} strokeWidth={1.75} focusable="false" />
            </span>
            <h3>{title}</h3>
            <ul class="benefit-points">
              {points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="wrap mastermind-people">
    {
      profileGroups.map((group) => {
        const { id, title, accent, emptyName, minimumCards, people } = group;
        const headingId = `mastermind-${id}-heading`;
        const placeholders: Member[] = Array.from(
          { length: Math.max(0, minimumCards - people.length) },
          (_, index) => ({
            slug: `${id}-placeholder-${index + 1}`,
            name: emptyName,
            role: "",
            about: "",
            sample: true,
            links: [],
          }),
        );
        return (
          <section aria-labelledby={headingId}>
            <h2 id={headingId}>{title}</h2>
            <ul class="mastermind-profile-grid" role="list">
              {[...people, ...placeholders].map((member) => (
                <li>
                  <MemberCard member={member} accent={accent} sampleLabel="" />
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>

  <div class="wrap package-wrap">
    <section
      class="mastermind-eligibility"
      aria-labelledby="mastermind-eligibility-heading"
    >
      <h2 id="mastermind-eligibility-heading">Who Should Wait to Apply</h2>
      <ul class="benefit-points">
        <li>You’re planning to start working with HighLevel.</li>
        <li>You’re new to HighLevel and still learning the basics.</li>
        <li>You have two years or less of hands-on HighLevel experience.</li>
      </ul>
    </section>

    <section
      class="package"
      id="founding-membership"
      aria-labelledby="how-to-join-heading"
      tabindex="-1"
    >
      <div class="package-summary">
        <h2 id="how-to-join-heading">How to Join</h2>
        <p>
          We’re keeping the group small so members can get to know each other.
        </p>
        <div class="package-details">
          <h3>Founding Member Package</h3>
          <p class="price"><strong>$197</strong> <span>/ year</span></p>
          <p>Limited to 20 founding members.</p>
        </div>
        <Button
          href={applicationUrl}
          label="Apply for Membership"
          data-membership-open
          aria-haspopup="dialog"
          aria-controls="membership-dialog"
        />
      </div>
      <ol class="join-steps" role="list">
        {
          joinSteps.map(({ title, description }, index) => (
            <li class="join-step">
              <span class="join-step-number" aria-hidden="true">
                {index + 1}
              </span>
              <div class="join-step-details">
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <section class="wrap mastermind-rules" aria-labelledby="rules-heading">
    <h2 id="rules-heading">Group rules</h2>
    <ul class="mastermind-lines" role="list">
      <li>
        <h3>Keep details private</h3>
        <p>
          Keep group discussions within the group. Leave out private client
          details when you share a case.
        </p>
      </li>
      <li>
        <h3>Take part</h3>
        <p>Share what you’ve tried and offer feedback when you can.</p>
      </li>
      <li>
        <h3>Keep calls free of sales pitches</h3>
        <p>Ask before sending a sales message to another member.</p>
      </li>
    </ul>
  </section>
  <dialog id="membership-dialog" aria-labelledby="membership-dialog-title">
    <div class="membership-popup">
      <header class="membership-popup-header">
        <h2 id="membership-dialog-title">Apply for Membership</h2>
        <button type="button" class="membership-close" aria-label="Close membership application" autofocus>✕</button>
      </header>
      <iframe
        data-src={applicationUrl}
        title="Mastermind membership application form"
        class="membership-form"
      ></iframe>
      <p class="membership-fallback">
        Having trouble with the form? <a href={applicationUrl} target="_blank" rel="noopener noreferrer">Open it in a new tab</a>.
      </p>
    </div>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>("#membership-dialog");
    const frame = dialog?.querySelector<HTMLIFrameElement>("iframe");
    let opener: HTMLElement | null = null;
    let previousOverflow = "";

    document.querySelectorAll<HTMLAnchorElement>("[data-membership-open]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        if (!dialog || !frame) return;
        event.preventDefault();
        opener = trigger;
        previousOverflow = document.body.style.overflow;
        if (!frame.getAttribute("src")) frame.src = frame.dataset.src!;
        dialog.showModal();
        document.body.style.overflow = "hidden";
      });
    });
    dialog?.querySelector(".membership-close")?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
    dialog?.addEventListener("close", () => {
      document.body.style.overflow = previousOverflow;
      opener?.focus({ preventScroll: true });
    });
  </script>
</Layout>

<style>
  #membership-dialog {
    width: min(760px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 24px 80px rgb(0 0 0 / 30%);
  }
  #membership-dialog::backdrop { background: rgb(3 16 29 / 75%); }
  .membership-popup { display: flex; flex-direction: column; height: min(850px, calc(100dvh - 32px)); }
  .membership-popup-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; }
  .membership-popup-header h2 { margin: 0; font-size: clamp(18px, 4vw, 24px); }
  .membership-close { flex: none; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: var(--paper-2); color: var(--ink); cursor: pointer; }
  .membership-form { display: block; width: 100%; flex: 1; min-height: 0; border: 0; background: #fff; }
  .membership-fallback { margin: 0; padding: 12px 20px; font-size: 13px; }
  .membership-fallback a { text-decoration: underline; }

  :global(#member-card-farhad-hossen .member-photo) {
    background: var(--paper-2);
  }

  :global(#member-card-tareq-mahmud .member-photo img) {
    object-fit: cover;
    object-position: center top;
    scale: 1.65;
    transform-origin: center top;
  }

  .mastermind-intro :global(.page-intro h1) {
    max-width: 22ch;
    font-size: clamp(42px, 6.1vw, 88px);
    text-wrap: balance;
  }

  .mastermind-intro :global(#page-intro-title .grad-text) {
    display: block;
    width: fit-content;
    margin-inline: auto;
  }

  .intro-actions {
    margin-top: 28px;
  }

  .mastermind-rules {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px clamp(32px, 7vw, 96px);
    padding-block: clamp(48px, 7vw, 92px);
  }

  .mastermind-audience {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(36px, 6vw, 84px);
    padding: clamp(32px, 5vw, 64px) clamp(20px, 5vw, 72px);
    border: 2px solid var(--green);
    border-radius: calc(var(--radius) + 8px);
    background: #fff;
    box-shadow: 0 20px 44px -30px rgba(6, 29, 48, 0.35);
    color: var(--navy);
    text-align: center;
  }

  .mastermind-audience p {
    max-width: 68ch;
    margin: 16px auto 0;
    color: color-mix(in srgb, var(--navy) 78%, #fff);
  }

  .audience-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .mastermind-lines {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .mastermind-lines li {
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .mastermind-lines h3,
  .package h3 {
    font-size: clamp(20px, 2.1vw, 28px);
  }

  .mastermind-lines p {
    margin-top: 6px;
    color: var(--ink-2);
  }

  .mastermind-benefits {
    padding-block: clamp(56px, 8vw, 108px) clamp(44px, 5.5vw, 72px);
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: clamp(24px, 4vw, 44px) 0 0;
    padding: 0;
    list-style: none;
  }

  .benefit,
  .mastermind-eligibility {
    padding: clamp(22px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }

  .mastermind-eligibility {
    margin-bottom: clamp(20px, 3vw, 32px);
    border-inline-start: 4px solid var(--yellow);
  }

  .mastermind-eligibility h2 {
    font-size: clamp(24px, 3vw, 36px);
  }

  .benefit-icon {
    --icon-accent: var(--green);
    display: grid;
    place-items: center;
    width: 56px;
    aspect-ratio: 1;
    margin-bottom: 20px;
    border: 1px solid color-mix(in srgb, var(--icon-accent) 34%, var(--card));
    border-radius: var(--radius-sm);
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--icon-accent) 9%, var(--card)),
      color-mix(in srgb, var(--icon-accent) 23%, var(--card))
    );
    box-shadow: 0 3px 0 color-mix(in srgb, var(--icon-accent) 22%, var(--card));
    color: color-mix(in srgb, var(--icon-accent) 34%, var(--ink));
  }

  .benefit-icon[data-color="blue"] {
    --icon-accent: var(--blue);
  }

  .benefit-icon[data-color="yellow"] {
    --icon-accent: var(--yellow);
  }

  .benefit h3 {
    font-size: clamp(21px, 2vw, 30px);
  }

  .benefit-points {
    display: grid;
    gap: 6px;
    margin: 16px 0 0;
    padding-inline-start: 1.15em;
    color: var(--ink-2);
  }

  .benefit-points li::marker {
    color: var(--forest);
  }

  .benefit:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .benefit:last-child:nth-child(odd) .benefit-points {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 32px;
  }

  .mastermind-people {
    display: grid;
    gap: clamp(28px, 4vw, 52px);
  }

  .mastermind-profile-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 24px);
    margin: clamp(20px, 3vw, 34px) 0 0;
    padding: 0;
    list-style: none;
  }

  .package-wrap {
    padding-top: clamp(56px, 8vw, 108px);
  }

  .package {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: 36px clamp(28px, 5vw, 66px);
    scroll-margin-top: 24px;
    padding: clamp(26px, 5vw, 72px);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse at top right, var(--navy-3), transparent 70%),
      var(--navy);
    color: var(--on-dark);
  }

  .package p {
    margin: 12px 0 0;
    color: var(--on-dark-2);
  }

  .package-details {
    margin-top: clamp(24px, 4vw, 44px);
    padding-top: 22px;
    border-top: 1px solid var(--line-dark);
  }

  .package-summary :global(.btn) {
    margin-top: 20px;
  }

  .package .price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 16px 0 0;
    white-space: nowrap;
  }

  .price strong {
    color: #8ee6b0;
    font-size: clamp(44px, 7vw, 80px);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .join-steps {
    --step-gap: 16px;
    --step-size: clamp(31px, 3.5vw, 44px);
    display: grid;
    gap: var(--step-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .join-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--step-size) minmax(0, 1fr);
    align-items: start;
    gap: clamp(10px, 2vw, 22px);
  }

  .join-step:not(:last-child)::before {
    content: "";
