---
import Layout from "../layouts/CommunityLayout.astro";
import Resources from "../components/community/Resources.astro";
import Join from "../components/community/Join.astro";
---

<Layout title="Learning Resources — GHL Bangladesh"
  ><section class="page-hero wrap">
    <span class="eyebrow">LESS SEARCHING. MORE LEARNING.</span><h1>
      Keep building.<br /><em>Keep getting better.</em>
    </h1><p>
      A practical starting point for finding answers, exploring HighLevel, and
      keeping your skills moving forward.
    </p>
  </section><section
    class="wrap section resource-section"
    style="padding-top:0"
  >
    <div>
      <h2>A few good places<br /><em>to start.</em></h2><p>
        Explore HighLevel’s own learning and support resources. Each link opens
        an external website.
      </p><div class="resource-note">
        Need another perspective? Bring your question to the community. Someone
        else may be working through the same thing.
      </div>
    </div><Resources />
  </section><Join /></Layout
>
