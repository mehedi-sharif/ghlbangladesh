---
import Layout from "../layouts/CommunityLayout.astro";
import PageIntro from "../components/community/PageIntro.astro";
import BangladeshMap from "../components/community/BangladeshMap.astro";
import Button from "../components/community/Button.astro";
import Join from "../components/community/Join.astro";
import { groupUrl } from "../data/community";
---

<Layout
  title="Volunteers — GHL Bangladesh"
  description="Volunteer opportunities for GHL Bangladesh are coming soon. Follow the community for roles and details on how to get involved."
>
  <PageIntro
    kicker="GHL Bangladesh"
    title="Volunteer"
    accent="with us."
    lead="We’ll open volunteer opportunities very soon."
  />
  <section class="volunteer-page" aria-label="How to get involved">
    <div class="wrap volunteer-inner">
      <div class="volunteer-copy reveal">
        <span class="volunteer-status"
          ><span class="volunteer-dot" aria-hidden="true"></span>Opening soon</span
        >
        <p class="volunteer-description">
          We’ll share the available roles and how to get involved when
          opportunities open.
        </p>
        <div class="volunteer-actions">
          <Button label="Get community updates" href={groupUrl} />
        </div>
      </div>
      <div class="volunteer-map reveal">
        <BangladeshMap />
      </div>
    </div>
  </section>
  <Join />
</Layout>

<style>
  .volunteer-page {
    padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 110px);
  }
  .volunteer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .volunteer-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .volunteer-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .volunteer-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: volunteer-pulse 2.4s ease-out infinite;
  }
  @keyframes volunteer-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--yellow) 60%, transparent);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  /* the page's main message, set large */
  .volunteer-description {
    margin: 22px 0 0;
    max-width: 520px;
    font-family: var(--display);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .volunteer-actions {
    margin-top: 28px;
  }
  .volunteer-map {
    justify-self: center;
    width: 100%;
    max-width: 440px;
  }
  @media (max-width: 760px) {
    .volunteer-inner {
      grid-template-columns: 1fr;
    }
    .volunteer-map {
      max-width: 260px;
      justify-self: start;
    }
  }
</style>
